{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=webshop.db"
  },
  "Seed": {
    "DemoCatalog": true,
    "LuxuryCatalog": true,
    "SourceSiteSync": true,
    "RemoteImageImport": true
  },
  "Media": {
    "IconWidth": 96,
    "ThumbWidth": 400,
    "MediumWidth": 800,
    "LargeWidth": 1200,
    "WebpQuality": 78,
    "MaxUploadBytes": 15728640,
    "DedupeOnUpload": true,
    "GarbageCollectEnabled": true,
    "GarbageCollectIntervalDays": 7
  },
  "Seo": {
    "AllowIndexing": false
  },
  "Gemini": {
    "ApiKey": "",
    "Model": "gemini-3.8-flash",
    "FallbackModels": [
      "gemini-3.1-flash-lite",
      "gemini-flash-latest",
      "gemini-2.5-flash-lite"
    ]
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
