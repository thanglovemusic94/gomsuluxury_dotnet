@page
@model WebShop.Pages.Admin.Landings.IndexModel
@{
	ViewData["Title"] = "Landing Page";
	ViewData["Menu"] = "Landings";
}

<div class="page-header">
	<h1>
		Landing Page
		<small><i class="ace-icon fa fa-angle-double-right"></i> chiến dịch Ads · layout tối giản</small>
		<a href="/Admin/Landings/Edit" class="btn btn-sm btn-primary pull-right">Thêm landing</a>
	</h1>
</div>
<partial name="_AdminAlerts" />

<div class="widget-box">
	<div class="widget-body">
		<div class="widget-main no-padding">
			<table class="table table-striped table-bordered table-hover">
				<thead>
					<tr>
						<th>Chiến dịch</th>
						<th>URL</th>
						<th>Trạng thái</th>
						<th>Tracking</th>
						<th>Đơn</th>
						<th>Khi tắt</th>
						<th></th>
					</tr>
				</thead>
				<tbody>
				@if (Model.Items.Count == 0)
				{
					<tr><td colspan="7">Chưa có landing. Tạo trang `/lp/...` cho từng chiến dịch Ads.</td></tr>
				}
				@foreach (var row in Model.Items)
				{
					var item = row.Page;
					<tr data-href="/Admin/Landings/Edit/@item.Id">
						<td>@item.Name</td>
						<td>
							<code>/lp/@item.Slug</code>
							<a class="btn btn-xs btn-link" href="/lp/@item.Slug" target="_blank" rel="noopener" title="Mở live">
								<i class="ace-icon fa fa-external-link"></i>
							</a>
						</td>
						<td>
							@(item.IsActive ? "Đang chạy" : "Tắt")
							@if (item.OfferEndsAt is DateTime ends)
							{
								<br /><small class="text-muted">đến @ends.ToString("dd/MM HH:mm")</small>
							}
						</td>
						<td>@(row.HasTracking ? "Có" : "—")</td>
						<td>@row.OrderCount</td>
						<td>@item.RedirectWhenOff</td>
						<td class="text-right">
							<a class="btn btn-xs btn-info" href="/Admin/Landings/Edit/@item.Id">Sửa</a>
							<form method="post" asp-page-handler="Delete" asp-route-id="@item.Id" class="inline" onsubmit="return confirm('Xóa landing này?');">
								<button type="submit" class="btn btn-xs btn-danger">Xóa</button>
							</form>
						</td>
					</tr>
				}
				</tbody>
			</table>
		</div>
	</div>
</div>
