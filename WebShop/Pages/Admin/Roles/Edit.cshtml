@page "{id:int?}"
@model WebShop.Pages.Admin.Roles.EditModel
@{
    ViewData["Title"] = Model.Input.Id == 0 ? "Thêm vai trò" : "Sửa vai trò";
    ViewData["Menu"] = "Roles";
	ViewData["AdminBackHref"] = "/Admin/Roles";
}

<div class="page-header"><h1><partial name="_AdminBackLink" />@ViewData["Title"]</h1></div>
<partial name="_AdminAlerts" />

<form method="post" class="form-horizontal">
	<input asp-for="Input.Id" type="hidden" />
	<div class="widget-box">
		<div class="widget-header"><h4 class="widget-title">Vai trò</h4></div>
		<div class="widget-body"><div class="widget-main">
			<div class="form-group">
				<label class="col-sm-3 control-label">Tên</label>
				<div class="col-sm-9"><input asp-for="Input.Name" class="form-control" maxlength="50" /></div>
			</div>
			<div class="form-group">
				<label class="col-sm-3 control-label">Mô tả</label>
				<div class="col-sm-9"><input asp-for="Input.Description" class="form-control" maxlength="255" /></div>
			</div>
			<div class="clearfix form-actions">
				<div class="col-sm-offset-3 col-sm-9">
					<button type="submit" class="btn btn-primary"><i class="ace-icon fa fa-check"></i> Lưu</button>
					<a class="btn btn-default" href="/Admin/Roles">Hủy</a>
				</div>
			</div>
		</div></div>
	</div>
</form>
