@page
@model WebShop.Pages.Admin.Roles.IndexModel
@{
    ViewData["Title"] = "Phân quyền";
    ViewData["Menu"] = "Roles";
}

<div class="page-header">
	<h1>
		Phân quyền
		<small><i class="ace-icon fa fa-angle-double-right"></i> vai trò</small>
		<a href="/Admin/Roles/Edit" class="btn btn-sm btn-primary pull-right">Thêm vai trò</a>
	</h1>
</div>
<partial name="_AdminAlerts" />

<div class="widget-box">
	<div class="widget-body">
		<div class="widget-main no-padding">
			<table class="table table-striped table-bordered table-hover">
				<thead>
					<tr><th>Tên</th><th>Mô tả</th><th></th></tr>
				</thead>
				<tbody>
				@if (Model.Items.Count == 0)
				{
					<tr><td colspan="3">Chưa có vai trò.</td></tr>
				}
				@foreach (var role in Model.Items)
				{
					<tr data-href="/Admin/Roles/Edit/@role.Id">
						<td>@role.Name</td>
						<td>@role.Description</td>
						<td class="text-right">
							<a class="btn btn-xs btn-info" href="/Admin/Roles/Edit/@role.Id">Sửa</a>
							<form method="post" asp-page-handler="Delete" asp-route-id="@role.Id" class="inline" onsubmit="return confirm('Xóa vai trò này?');">
								<button type="submit" class="btn btn-xs btn-danger">Xóa</button>
							</form>
						</td>
					</tr>
				}
				</tbody>
			</table>
		</div>
</div>
</div>
