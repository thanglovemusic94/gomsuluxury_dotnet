@page "/Admin/AuditLogs"
@model WebShop.Pages.Admin.AuditLogs.IndexModel
@{
	ViewData["Title"] = "Nhật ký";
	ViewData["Menu"] = "AuditLogs";
	ViewData["AdminAssets"] = "bulk";
	var pager = Model.Pager(Model.ListUrl);
	var actions = new[] { AuditActions.Create, AuditActions.Update, AuditActions.SoftDelete, AuditActions.Restore, AuditActions.HardDelete };
	var entityTypes = new[] { AuditEntities.Product, AuditEntities.Post, AuditEntities.Page, AuditEntities.Media };
}

<div class="page-header">
	<h1>Nhật ký <small><i class="ace-icon fa fa-angle-double-right"></i> sửa · xóa · khôi phục</small></h1>
</div>
<partial name="_AdminAlerts" />

<div class="widget-box">
	<div class="widget-header"><h4 class="widget-title">Bộ lọc</h4></div>
	<div class="widget-body"><div class="widget-main">
		<form method="get" class="form-inline">
			<input type="hidden" name="PageSize" value="@Model.PageSize" />
			<select name="Action" class="form-control input-sm">
				<option value="">Mọi hành động</option>
				@foreach (var a in actions)
				{
					if (Model.Action == a)
					{
						<option value="@a" selected>@AuditActions.Label(a)</option>
					}
					else
					{
						<option value="@a">@AuditActions.Label(a)</option>
					}
				}
			</select>
			<select name="EntityType" class="form-control input-sm">
				<option value="">Mọi loại</option>
				@foreach (var t in entityTypes)
				{
					if (Model.EntityType == t)
					{
						<option value="@t" selected>@AuditEntities.Label(t)</option>
					}
					else
					{
						<option value="@t">@AuditEntities.Label(t)</option>
					}
				}
			</select>
			<input type="text" name="Username" value="@Model.Username" class="form-control input-sm" placeholder="Username" />
			<button type="submit" class="btn btn-sm btn-primary">Lọc</button>
		</form>
	</div></div>
</div>

<div class="widget-box js-admin-bulk-root">
	<form method="post" asp-page-handler="BulkDelete" id="audit-bulk-form">
		<input type="hidden" name="pageNumber" value="@Model.PageNumber" />
		<input type="hidden" name="pageSize" value="@Model.PageSize" />
		<input type="hidden" name="action" value="@Model.Action" />
		<input type="hidden" name="entityType" value="@Model.EntityType" />
		<input type="hidden" name="username" value="@Model.Username" />
		<div class="widget-header"><h4 class="widget-title">Nhật ký (@Model.TotalCount)</h4></div>
		<div class="admin-bulk-bar">
			<label class="checkbox-inline" style="margin:0;">
				<input type="checkbox" class="js-admin-select-all" /> Chọn tất cả trang này
			</label>
			<span class="text-muted">Đã chọn: <strong class="js-admin-bulk-count">0</strong></span>
			<button type="submit"
			        class="btn btn-xs btn-danger js-admin-bulk-delete"
			        disabled
			        onclick="return confirm('Xóa các bản ghi nhật ký đã chọn? Không hoàn tác được.');">
				Xóa đã chọn
			</button>
		</div>
	</form>
	<div class="widget-body">
		<div class="widget-main no-padding">
		<table class="table table-striped table-bordered" style="margin:0;">
			<thead>
				<tr>
					<th class="admin-check-col"></th>
					<th style="width:130px;">Thời gian</th>
					<th style="width:100px;">Người</th>
					<th style="width:90px;">Hành động</th>
					<th>Đối tượng</th>
					<th>Chi tiết</th>
				</tr>
			</thead>
			<tbody>
			@if (Model.Items.Count == 0)
			{
				<tr><td colspan="6" class="text-muted text-center">Chưa có nhật ký.</td></tr>
			}
			else foreach (var item in Model.Items)
			{
				<tr>
					<td class="admin-check-col">
						<input type="checkbox"
						       class="js-admin-row-check"
						       name="ids"
						       value="@item.Id"
						       form="audit-bulk-form"
						       aria-label="Chọn nhật ký #@item.Id" />
					</td>
					<td>@item.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
					<td>@item.Username</td>
					<td><span class="label label-info">@AuditActions.Label(item.Action)</span></td>
					<td>
						@AuditEntities.Label(item.EntityType) #@item.EntityId
						@if (!string.IsNullOrWhiteSpace(item.EntityTitle))
						{
							<span>· @item.EntityTitle</span>
						}
						@if (item.Action == AuditActions.SoftDelete)
						{
							<div style="margin-top:4px;">
								<a class="btn btn-minier btn-info" href="/Admin/Trash/Detail?Type=@Uri.EscapeDataString(item.EntityType)&Id=@item.EntityId">Xem chi tiết xóa</a>
							</div>
						}
					</td>
					<td>
						<div>@(item.Summary ?? "—")</div>
						@if (!string.IsNullOrWhiteSpace(item.Details))
						{
							<pre style="margin:6px 0 0;font-size:11px;white-space:pre-wrap;max-height:120px;overflow:auto;background:#f9f9f9;border:1px solid #eee;padding:6px;">@item.Details</pre>
						}
					</td>
				</tr>
			}
			</tbody>
		</table>
		</div>
		<partial name="_AdminPager" model="pager" />
	</div>
</div>
