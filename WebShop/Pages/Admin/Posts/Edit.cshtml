@page "{id:int?}"
@model WebShop.Pages.Admin.Posts.EditModel
@{
    ViewData["Title"] = Model.Input.Id == 0 ? "Thêm bài viết" : "Sửa bài viết";
    ViewData["Menu"] = "Posts";
	ViewData["AdminBackHref"] = "/Admin/Posts";
}

<div class="page-header"><h1><partial name="_AdminBackLink" />@ViewData["Title"]</h1></div>
<partial name="_AdminAlerts" />

<form method="post" class="form-horizontal">
	<input asp-for="Input.Id" type="hidden" />
	<div class="widget-box">
		<div class="widget-header"><h4 class="widget-title">Bài viết</h4></div>
		<div class="widget-body"><div class="widget-main">
			<div class="form-group">
				<label class="col-sm-3 control-label">Danh mục</label>
				<div class="col-sm-9">
					<select asp-for="Input.CategoryId" class="form-control">
						<option value="">Chọn danh mục blog</option>
						@foreach (var category in Model.Categories)
						{
							<option value="@category.Id">@category.Name</option>
						}
					</select>
				</div>
			</div>
			<div class="form-group">
				<label class="col-sm-3 control-label">Tác giả</label>
				<div class="col-sm-9">
					<select asp-for="Input.AuthorId" class="form-control">
						<option value="">Chọn tác giả</option>
						@foreach (var author in Model.Authors)
						{
							<option value="@author.Id">@author.Username</option>
						}
					</select>
				</div>
			</div>
			<div class="form-group">
				<label class="col-sm-3 control-label">Tiêu đề</label>
				<div class="col-sm-9"><input asp-for="Input.Title" class="form-control" maxlength="250" /></div>
			</div>
			<div class="form-group">
				<label class="col-sm-3 control-label">Slug</label>
				<div class="col-sm-9"><input asp-for="Input.Slug" class="form-control" maxlength="255" /></div>
			</div>
			<div class="form-group">
				<label class="col-sm-3 control-label">Tóm tắt</label>
				<div class="col-sm-9"><textarea asp-for="Input.Summary" class="form-control" maxlength="500" rows="2"></textarea></div>
			</div>
			<div class="form-group">
				<label class="col-sm-3 control-label">Nội dung</label>
				<div class="col-sm-9">
					<textarea asp-for="Input.Content" class="form-control js-ckeditor" rows="12"></textarea>
					<span class="help-block">Soạn thảo trực quan, nút Source để sửa HTML. Ảnh/file qua Image → Browse Server.</span>
				</div>
			</div>
			<div class="form-group">
				<label class="col-sm-3 control-label">Ảnh</label>
				<div class="col-sm-9">
					<div class="input-group">
						<input asp-for="Input.ImageUrl" class="form-control" maxlength="500" id="Input_ImageUrl" />
						<span class="input-group-btn">
							<button type="button" class="btn btn-info js-media-pick" data-input="Input_ImageUrl" data-size="medium" data-folder="tin-tuc">
								<i class="fa fa-folder-open"></i> Thư viện
							</button>
						</span>
					</div>
				</div>
			</div>
			<div class="form-group">
				<div class="col-sm-offset-3 col-sm-9">
					<label><input asp-for="Input.IsPublished" /> Xuất bản</label>
				</div>
			</div>
		</div></div>
	</div>
	<div class="widget-box">
		<div class="widget-header"><h4 class="widget-title">SEO</h4></div>
		<div class="widget-body"><div class="widget-main">
			<partial name="_SeoFields" for="Seo" />
			<div class="clearfix form-actions">
				<div class="col-sm-offset-3 col-sm-9">
					<button type="submit" class="btn btn-primary"><i class="ace-icon fa fa-check"></i> Lưu</button>
					<a class="btn btn-default" href="/Admin/Posts">Hủy</a>
				</div>
			</div>
		</div></div>
	</div>
</form>

@section Scripts {
	<script src="https://cdn.ckeditor.com/4.22.1/full/ckeditor.js"></script>
	<script src="/js/admin-editor.js"></script>
	<script>
		WebShopEditor.replace('.js-ckeditor');
		WebShopEditor.bindForms();
		WebShopEditor.bindMediaPickers();
	</script>
}
