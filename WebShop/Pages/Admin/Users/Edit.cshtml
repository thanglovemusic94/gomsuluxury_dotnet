@page "{id:int?}"
@model WebShop.Pages.Admin.Users.EditModel
@{
    ViewData["Title"] = Model.Input.Id == 0 ? "Thêm thành viên" : "Sửa thành viên";
    ViewData["Menu"] = "Users";
}

<div class="page-header">
	<h1>@ViewData["Title"]</h1>
</div>
<partial name="_AdminAlerts" />

<form method="post" class="form-horizontal">
	<input asp-for="Input.Id" type="hidden" />
	<div class="widget-box">
		<div class="widget-header"><h4 class="widget-title">Tài khoản</h4></div>
		<div class="widget-body"><div class="widget-main">
			<div class="form-group">
				<label class="col-sm-3 control-label">Tên đăng nhập</label>
				<div class="col-sm-9"><input asp-for="Input.Username" class="form-control" maxlength="50" /></div>
			</div>
			<div class="form-group">
				<label class="col-sm-3 control-label">Email</label>
				<div class="col-sm-9"><input asp-for="Input.Email" class="form-control" maxlength="150" /></div>
			</div>
			<div class="form-group">
				<label class="col-sm-3 control-label">Mật khẩu</label>
				<div class="col-sm-9">
					<input asp-for="Input.Password" type="password" class="form-control" autocomplete="new-password" />
					<span class="help-block">@(Model.Input.Id == 0 ? "Bắt buộc khi tạo mới." : "Để trống nếu không đổi mật khẩu.")</span>
				</div>
			</div>
			<div class="form-group">
				<label class="col-sm-3 control-label">Họ tên</label>
				<div class="col-sm-9"><input asp-for="Input.FullName" class="form-control" maxlength="100" /></div>
			</div>
			<div class="form-group">
				<label class="col-sm-3 control-label">Điện thoại</label>
				<div class="col-sm-9"><input asp-for="Input.PhoneNumber" class="form-control" maxlength="15" /></div>
			</div>
			<div class="form-group">
				<label class="col-sm-3 control-label">Vai trò</label>
				<div class="col-sm-9">
					@foreach (var role in Model.Roles)
					{
						<label class="checkbox-inline">
							<input type="checkbox" name="Input.RoleIds" value="@role.Id" @(Model.Input.RoleIds.Contains(role.Id) ? "checked" : null) />
							@role.Name
						</label>
					}
				</div>
			</div>
			<div class="form-group">
				<div class="col-sm-offset-3 col-sm-9">
					<label><input asp-for="Input.IsActive" /> Đang hoạt động</label>
				</div>
			</div>
			<div class="clearfix form-actions">
				<div class="col-sm-offset-3 col-sm-9">
					<button type="submit" class="btn btn-primary"><i class="ace-icon fa fa-check"></i> Lưu</button>
					<a class="btn btn-default" href="/Admin/Users">Hủy</a>
				</div>
			</div>
		</div></div>
	</div>
</form>
