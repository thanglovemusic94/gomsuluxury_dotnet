@page "/Admin/CkFinder/Browse"
@model WebShop.Pages.Admin.Media.BrowseModel
@using WebShop.Infrastructure
@{
	Layout = null;
	var isPicker = !string.IsNullOrWhiteSpace(Model.CKEditorFuncNum) || !string.IsNullOrWhiteSpace(Model.InputId);
	var folder = MediaFolders.Normalize(Model.Folder);
	var canDeleteFolder = folder != MediaFolders.All && !MediaFolders.IsBuiltIn(folder);
	var data = Model.PageData;
	string PickUrl(MediaItem item) => (Model.Size ?? "medium").ToLowerInvariant() switch
	{
		"thumb" => item.ThumbUrl,
		"large" => item.LargeUrl,
		"original" => item.OriginalUrl,
		_ => item.MediumUrl
	};
	string Link(string f, int p = 1) =>
		$"/Admin/CkFinder/Browse?Type={Model.Type}&Size={Model.Size}&Folder={Uri.EscapeDataString(f)}&PageNumber={p}&CKEditor={Uri.EscapeDataString(Model.CKEditor ?? "")}&CKEditorFuncNum={Uri.EscapeDataString(Model.CKEditorFuncNum ?? "")}&InputId={Uri.EscapeDataString(Model.InputId ?? "")}";
	string SizeLabel(long bytes) =>
		bytes < 1024 ? $"{bytes} B" :
		bytes < 1024 * 1024 ? $"{bytes / 1024.0:0.#} KB" :
		$"{bytes / (1024.0 * 1024):0.#} MB";
}
<!DOCTYPE html>
<html lang="vi">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<title>Thư viện media</title>
	<link rel="stylesheet" href="/ace/assets/css/bootstrap.min.css" />
	<link rel="stylesheet" href="/ace/assets/font-awesome/4.5.0/css/font-awesome.min.css" />
	<style>
		body { background: #eef1f4; margin: 0; font-family: "Open Sans", "Helvetica Neue", Helvetica, Arial, sans-serif; color: #333; }
		.ckf-layout { display: grid; grid-template-columns: 200px 1fr; min-height: 100vh; }
		.ckf-side { background: #fff; border-right: 1px solid #dde2e8; padding: 12px 10px; overflow-x: auto; }
		.ckf-side h2 { margin: 0 0 10px; font-size: 13px; text-transform: uppercase; letter-spacing: .04em; color: #777; }
		.ckf-side a {
			display: flex; justify-content: space-between; align-items: center; gap: 8px;
			padding: 7px 10px; color: #444; text-decoration: none; border-radius: 4px; margin-bottom: 1px; font-size: 13px;
		}
		.ckf-side a:hover, .ckf-side a.is-active { background: #e8f2fb; color: #1e6bb8; }
		.ckf-side a.is-active { font-weight: 600; }
		.ckf-side a .ckf-folder-name { display: flex; align-items: center; gap: 6px; min-width: 0; }
		.ckf-side a .ckf-folder-name span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
		.ckf-side a .ckf-folder-count { flex-shrink: 0; color: #888; font-size: 11px; }
		.ckf-main { display: flex; flex-direction: column; min-width: 0; }
		.ckf-toolbar {
			display: flex; flex-wrap: wrap; gap: 4px; align-items: center;
			padding: 8px 12px; background: #f7f8fa; border-bottom: 1px solid #dde2e8;
			position: sticky; top: 0; z-index: 30;
		}
		.ckf-toolbar .btn { border-radius: 3px; }
		.ckf-toolbar .btn[disabled], .ckf-toolbar a.disabled { opacity: .4; pointer-events: none; }
		.ckf-toolbar__sep { width: 1px; height: 22px; background: #d0d7de; margin: 0 6px; }
		.ckf-toolbar__count { margin-left: auto; font-size: 12px; color: #1e6bb8; font-weight: 600; }
		.ckf-body { padding: 14px 16px 28px; }
		.ckf-drop {
			border: 1px dashed #c5ced8; background: #fafbfc; border-radius: 4px;
			padding: 10px 12px; margin-bottom: 12px; color: #777; font-size: 13px;
		}
		.ckf-head { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; justify-content: space-between; margin-bottom: 12px; }
		.ckf-title { margin: 0; font-size: 16px; }
		.ckf-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(148px, 1fr)); gap: 12px; }
		.ckf-card {
			background: #fff; border: 1px solid #dde2e8; border-radius: 4px; overflow: hidden;
			cursor: pointer; user-select: none; min-height: 188px;
			display: flex; flex-direction: column;
			transition: border-color .12s, box-shadow .12s;
		}
		.ckf-card:hover { border-color: #5b9bd5; }
		.ckf-card.is-picked { border-color: #1e6bb8; box-shadow: 0 0 0 2px rgba(30,107,184,.35); position: relative; }
		.ckf-card.is-picked::after {
			content: "\f00c"; font-family: FontAwesome; position: absolute; top: 6px; right: 6px; z-index: 2;
			width: 20px; height: 20px; line-height: 20px; text-align: center; border-radius: 50%;
			background: #1e6bb8; color: #fff; font-size: 10px;
		}
		.ckf-thumb {
			height: 108px; display: flex; align-items: center; justify-content: center; background: #f4f6f8; overflow: hidden;
		}
		.ckf-thumb img { max-width: 100%; max-height: 108px; object-fit: contain; pointer-events: none; }
		.ckf-card--folder { text-decoration: none; color: inherit; }
		.ckf-card--folder:hover { border-color: #e6a817; }
		.ckf-card--folder .ckf-thumb { background: #fff8e8; color: #e6a817; font-size: 48px; }
		.ckf-meta { padding: 8px; display: flex; flex-direction: column; gap: 2px; }
		.ckf-name {
			font-size: 11px; color: #333; min-height: 28px; line-height: 1.3; word-break: break-word;
			display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
		}
		.ckf-sub { font-size: 10px; color: #888; }
		.ckf-empty { padding: 48px 20px; text-align: center; color: #888; background: #fff; border: 1px dashed #ccc; border-radius: 4px; }
		.ckf-pager { margin-top: 14px; }
		.ckf-pager a { margin-right: 5px; }
		.ckf-toast {
			position: fixed; right: 14px; bottom: 14px; z-index: 10050; background: #323232; color: #fff;
			padding: 10px 14px; border-radius: 4px; font-size: 12px; opacity: 0; transform: translateY(8px);
			transition: opacity .2s, transform .2s; max-width: 360px; pointer-events: none;
		}
		.ckf-toast.is-show { opacity: 1; transform: translateY(0); }
		.ckf-toast code { color: #a8d5ff; font-size: 10px; word-break: break-all; }

		.ckf-modal-backdrop {
			display: none; position: fixed; inset: 0; z-index: 10000; background: rgba(20,28,40,.45);
			align-items: center; justify-content: center; padding: 16px;
		}
		.ckf-modal-backdrop.is-on { display: flex; }
		.ckf-modal {
			background: #fff; border-radius: 4px; box-shadow: 0 12px 40px rgba(0,0,0,.22);
			width: min(420px, 100%); max-height: calc(100vh - 40px); overflow: auto;
		}
		.ckf-modal__head {
			padding: 12px 14px; border-bottom: 1px solid #e6ebf0; font-weight: 600; font-size: 14px;
		}
		.ckf-modal__body { padding: 14px; }
		.ckf-modal__foot {
			padding: 10px 14px; border-top: 1px solid #e6ebf0; display: flex; justify-content: flex-end; gap: 8px;
		}
		.ckf-radio { display: flex; align-items: center; gap: 8px; padding: 7px 0; font-size: 13px; cursor: pointer; }
		.ckf-radio input { margin: 0; }
		.ckf-custom-size { display: none; gap: 10px; margin: 8px 0 0 24px; }
		.ckf-custom-size.is-on { display: flex; flex-wrap: wrap; }
		.ckf-custom-size label { font-size: 12px; color: #666; display: flex; flex-direction: column; gap: 4px; }
		.ckf-custom-size input { width: 90px; height: 30px; }
		.ckf-folder-list { list-style: none; margin: 0; padding: 0; border: 1px solid #e2e6ea; border-radius: 4px; max-height: 260px; overflow: auto; }
		.ckf-folder-list button {
			display: flex; width: 100%; align-items: center; gap: 8px; border: 0; border-bottom: 1px solid #f0f2f5;
			background: #fff; padding: 10px 12px; text-align: left; font-size: 13px; cursor: pointer;
		}
		.ckf-folder-list button:last-child { border-bottom: 0; }
		.ckf-folder-list button:hover, .ckf-folder-list button.is-on { background: #e8f2fb; color: #1e6bb8; }
		.ckf-folder-list .fa { color: #3b82c4; }
		.ckf-newfolder-hint { font-size: 12px; color: #666; margin-bottom: 10px; }

		.ckf-viewer {
			display: none; position: fixed; inset: 0; z-index: 10040; background: rgba(10,14,20,.88);
			flex-direction: column; align-items: center; justify-content: center;
		}
		.ckf-viewer.is-on { display: flex; }
		.ckf-viewer__img { max-width: min(92vw, 1200px); max-height: calc(100vh - 100px); object-fit: contain; box-shadow: 0 10px 40px rgba(0,0,0,.4); }
		.ckf-viewer__nav {
			position: absolute; top: 50%; transform: translateY(-50%); width: 48px; height: 48px; border: 0; border-radius: 50%;
			background: rgba(0,0,0,.45); color: #fff; font-size: 22px; cursor: pointer;
		}
		.ckf-viewer__nav:hover { background: rgba(0,0,0,.65); }
		.ckf-viewer__prev { left: 18px; }
		.ckf-viewer__next { right: 18px; }
		.ckf-viewer__meta { margin-top: 12px; color: #fff; font-size: 13px; text-align: center; }
		.ckf-viewer__close {
			position: absolute; top: 14px; right: 16px; border: 0; background: transparent; color: #fff; font-size: 28px; cursor: pointer;
		}
		@@media (max-width: 720px) {
			.ckf-layout { grid-template-columns: 1fr; }
			.ckf-side { border-right: 0; border-bottom: 1px solid #dde2e8; }
		}
	</style>
</head>
<body>
	<div class="ckf-layout">
		<aside class="ckf-side">
			<h2><i class="fa fa-folder-open"></i> Thư mục</h2>
			<a class="@(folder == MediaFolders.All ? "is-active" : null)" href="@Link("")">
				<span class="ckf-folder-name"><i class="fa fa-folder-open-o"></i> <span>Tất cả</span></span>
				<span class="ckf-folder-count">@(data.FolderCounts.GetValueOrDefault(MediaFolders.All))</span>
			</a>
			@foreach (var item in Model.FolderList)
			{
				var pad = Math.Max(0, item.Depth) * 14;
				<a class="@(folder == item.Key ? "is-active" : null)" href="@Link(item.Key)" style="padding-left:@(10 + pad)px">
					<span class="ckf-folder-name">
						<i class="fa @(item.Depth > 0 ? "fa-folder-o" : "fa-folder")"></i>
						<span>@item.Label</span>
					</span>
					<span class="ckf-folder-count">@(data.FolderCounts.GetValueOrDefault(item.Key))</span>
				</a>
			}
		</aside>
		<main class="ckf-main">
			<div class="ckf-toolbar" id="ckfToolbar" data-picker="@(isPicker ? "1" : "0")">
				@if (isPicker)
				{
					<button type="button" class="btn btn-sm btn-success" id="ckfChoose" disabled><i class="fa fa-check"></i> Chọn</button>
					<button type="button" class="btn btn-sm btn-info" id="ckfChooseResized" disabled><i class="fa fa-picture-o"></i> Chọn resized</button>
					<span class="ckf-toolbar__sep"></span>
				}
				<label class="btn btn-sm btn-default" style="margin:0;cursor:pointer;">
					<i class="fa fa-cloud-upload"></i> Upload
					<input type="file" id="ckfUploadInput" name="files" accept="image/*" multiple hidden form="ckfUploadForm" />
				</label>
				<button type="button" class="btn btn-sm btn-default" id="ckfNewFolder"><i class="fa fa-folder-o"></i> New Subfolder</button>
				<button type="button" class="btn btn-sm btn-default" id="ckfRenameFolder" @(canDeleteFolder ? null : "disabled") title="Đổi tên thư mục đang mở"><i class="fa fa-font"></i> Đổi tên thư mục</button>
				<button type="button" class="btn btn-sm btn-default" id="ckfMoveFolder" @(canDeleteFolder ? null : "disabled") title="Di chuyển thư mục đang mở"><i class="fa fa-share"></i> Chuyển thư mục</button>
				<button type="button" class="btn btn-sm btn-danger" id="ckfDeleteFolder" @(canDeleteFolder ? null : "disabled") title="@(canDeleteFolder ? "Xóa thư mục + mọi thư mục con và file bên trong" : "Chỉ xóa được thư mục tùy chỉnh")"><i class="fa fa-folder"></i> Xóa thư mục</button>
				<button type="button" class="btn btn-sm btn-default" id="ckfView" disabled><i class="fa fa-eye"></i> Xem</button>
				<a class="btn btn-sm btn-default disabled" id="ckfDownload" href="#" target="_blank" rel="noopener"><i class="fa fa-download"></i> Tải</a>
				<a class="btn btn-sm btn-default disabled" id="ckfEdit" href="#" target="_blank" rel="noopener" title="Mở trong Admin Media"><i class="fa fa-pencil"></i> Sửa</a>
				<span class="ckf-toolbar__sep"></span>
				<button type="button" class="btn btn-sm btn-default" id="ckfCopy" disabled><i class="fa fa-files-o"></i> Copy</button>
				<button type="button" class="btn btn-sm btn-default" id="ckfMove" disabled><i class="fa fa-folder-open-o"></i> Move</button>
				<button type="button" class="btn btn-sm btn-default" id="ckfRename" disabled><i class="fa fa-font"></i> Rename</button>
				<button type="button" class="btn btn-sm btn-danger" id="ckfDelete" disabled><i class="fa fa-trash"></i> Delete</button>
				<span class="ckf-toolbar__count" id="ckfCount">0 chọn</span>
			</div>

			<div class="ckf-body">
				<div class="ckf-drop">Select files to upload — hoặc bấm Upload · Ctrl/⌘ + click chọn nhiều</div>
				<div class="ckf-head">
					<div>
						<h1 class="ckf-title">@MediaFolders.Label(folder)</h1>
						<small class="text-muted">@(isPicker ? "Chọn ảnh để chèn vào nội dung" : "Duyệt thư viện") · mặc định <strong>@Model.Size</strong></small>
					</div>
					<form method="post" asp-page-handler="Upload" enctype="multipart/form-data" id="ckfUploadForm" class="form-inline">
						<input type="hidden" name="Type" value="@Model.Type" />
						<input type="hidden" name="Size" value="@Model.Size" />
						<input type="hidden" name="CKEditor" value="@Model.CKEditor" />
						<input type="hidden" name="CKEditorFuncNum" value="@Model.CKEditorFuncNum" />
						<input type="hidden" name="InputId" value="@Model.InputId" />
						<input type="hidden" name="folder" value="@(folder == MediaFolders.All ? MediaFolders.Other : folder)" />
					</form>
				</div>

				@if (!string.IsNullOrWhiteSpace(Model.Flash))
				{
					<div class="alert alert-info">@Model.Flash</div>
				}

				@{
					var images = data.Items.Where(i => i.IsImage).ToList();
					var hasChildren = Model.ChildFolders.Count > 0;
					var hasFiles = images.Count > 0;
				}
				@if (!hasChildren && !hasFiles)
				{
					<div class="ckf-empty">Thư mục trống. Tạo subfolder, tải ảnh lên, hoặc chọn “Tất cả”.</div>
				}
				else
				{
					<div class="ckf-grid" id="ckfGrid">
						@foreach (var child in Model.ChildFolders)
						{
							var count = data.FolderCounts.GetValueOrDefault(child.Key);
							<a class="ckf-card ckf-card--folder" href="@Link(child.Key)" title="@MediaFolders.Label(child.Key)">
								<div class="ckf-thumb"><i class="fa fa-folder"></i></div>
								<div class="ckf-meta">
									<div class="ckf-name">@child.Label</div>
									<span class="ckf-sub">Thư mục@(count > 0 ? $" · {count} ảnh" : "")</span>
								</div>
							</a>
						}
						@foreach (var item in images)
						{
							var url = PickUrl(item);
							<div class="ckf-card"
							     role="button"
							     tabindex="0"
							     data-id="@item.Id"
							     data-url="@url"
							     data-thumb="@item.ThumbUrl"
							     data-medium="@item.MediumUrl"
							     data-large="@item.LargeUrl"
							     data-original="@item.OriginalUrl"
							     data-name="@item.Name"
							     data-folder="@item.Folder">
								<div class="ckf-thumb">
									<img src="@item.ThumbUrl" alt="@(item.Alt ?? item.Name)" loading="lazy" />
								</div>
								<div class="ckf-meta">
									<div class="ckf-name" title="@item.Name">@item.Name</div>
									<span class="ckf-sub">@item.ModifiedUtc.ToLocalTime().ToString("M/d/yyyy h:mm tt") · @SizeLabel(item.Size)</span>
								</div>
							</div>
						}
					</div>
					@if (data.TotalPages > 1)
					{
						<div class="ckf-pager">
							@for (var i = 1; i <= data.TotalPages; i++)
							{
								<a class="btn btn-xs @(i == data.Page ? "btn-primary" : "btn-default")" href="@Link(folder, i)">@i</a>
							}
						</div>
					}
				}
			</div>
		</main>
	</div>

	@* Choose Resized *@
	<div class="ckf-modal-backdrop" id="ckfResizeModal" aria-hidden="true">
		<div class="ckf-modal" role="dialog" aria-labelledby="ckfResizeTitle">
			<div class="ckf-modal__head" id="ckfResizeTitle">Choose Resized</div>
			<div class="ckf-modal__body">
				<label class="ckf-radio"><input type="radio" name="ckfResize" value="original" /> Original size</label>
				<label class="ckf-radio"><input type="radio" name="ckfResize" value="thumb" /> Small (thumb ~@MediaUrls.ThumbW)</label>
				<label class="ckf-radio"><input type="radio" name="ckfResize" value="medium" checked /> Medium (~@MediaUrls.MediumW)</label>
				<label class="ckf-radio"><input type="radio" name="ckfResize" value="large" /> Large (~@MediaUrls.LargeW)</label>
				<label class="ckf-radio"><input type="radio" name="ckfResize" value="custom" /> Custom</label>
				<div class="ckf-custom-size" id="ckfCustomSize">
					<label>Width <input type="number" id="ckfCustomW" class="form-control input-sm" min="16" max="1600" value="800" /></label>
					<label>Height <input type="number" id="ckfCustomH" class="form-control input-sm" min="16" max="1600" value="600" /></label>
				</div>
			</div>
			<div class="ckf-modal__foot">
				<button type="button" class="btn btn-default" data-close-modal="ckfResizeModal">Cancel</button>
				<button type="button" class="btn btn-success" id="ckfResizeOk">OK</button>
			</div>
		</div>
	</div>

	@* Copy / Move folder *@
	<div class="ckf-modal-backdrop" id="ckfFolderModal" aria-hidden="true">
		<div class="ckf-modal" role="dialog">
			<div class="ckf-modal__head" id="ckfFolderTitle">Copy File To...</div>
			<div class="ckf-modal__body">
				<ul class="ckf-folder-list" id="ckfFolderList">
					@foreach (var item in Model.FolderList)
					{
						var pad = Math.Max(0, item.Depth) * 14;
						<li>
							<button type="button" data-folder="@item.Key" style="padding-left:@(12 + pad)px">
								<i class="fa @(item.Depth > 0 ? "fa-folder-o" : "fa-folder")"></i> @item.Label
							</button>
						</li>
					}
				</ul>
			</div>
			<div class="ckf-modal__foot">
				<button type="button" class="btn btn-default" data-close-modal="ckfFolderModal">Cancel</button>
				<button type="button" class="btn btn-success" id="ckfFolderOk">OK</button>
			</div>
		</div>
	</div>

	@* New Subfolder *@
	<div class="ckf-modal-backdrop" id="ckfNewFolderModal" aria-hidden="true">
		<div class="ckf-modal" role="dialog">
			<div class="ckf-modal__head">New Subfolder</div>
			<div class="ckf-modal__body">
				<p class="ckf-newfolder-hint" id="ckfNewFolderHint">
					Trong: <strong>@(folder == MediaFolders.All ? "gốc (Tất cả)" : MediaFolders.Label(folder))</strong>
				</p>
				<label style="font-size:13px;display:block;margin-bottom:8px;">Type the new folder name:</label>
				<input type="text" class="form-control" id="ckfNewFolderInput" maxlength="60" placeholder="Ví dụ: Chiến dịch Tết" />
			</div>
			<div class="ckf-modal__foot">
				<button type="button" class="btn btn-default" data-close-modal="ckfNewFolderModal">Cancel</button>
				<button type="button" class="btn btn-success" id="ckfNewFolderOk">OK</button>
			</div>
		</div>
	</div>

	@* Delete folder (cascade) *@
	<div class="ckf-modal-backdrop" id="ckfDeleteFolderModal" aria-hidden="true">
		<div class="ckf-modal" role="dialog">
			<div class="ckf-modal__head">Xác nhận xóa thư mục</div>
			<div class="ckf-modal__body">
				<p style="margin:0 0 10px;font-size:13px;">
					Bạn có chắc muốn xóa thư mục <strong>@MediaFolders.Label(folder)</strong>?
				</p>
				<p style="margin:0 0 8px;font-size:13px;color:#a94442;">
					Thao tác này sẽ xóa <strong>toàn bộ thư mục con</strong>
					@if (Model.DeleteFolderSubfolderCount > 0)
					{
						<text> (@Model.DeleteFolderSubfolderCount)</text>
					}
					và <strong>mọi file bên trong</strong>
					@if (Model.DeleteFolderFileCount > 0)
					{
						<text> (@Model.DeleteFolderFileCount file → thùng rác)</text>
					}
					else
					{
						<text> (không có file)</text>
					}.
				</p>
				<p style="margin:0;font-size:12px;color:#666;">Không thể hoàn tác thư mục; file có thể khôi phục từ Thùng rác.</p>
			</div>
			<div class="ckf-modal__foot">
				<button type="button" class="btn btn-default" data-close-modal="ckfDeleteFolderModal">Không</button>
				<button type="button" class="btn btn-danger" id="ckfDeleteFolderOk">Có, xóa hết</button>
			</div>
		</div>
	</div>

	@* Rename folder *@
	<div class="ckf-modal-backdrop" id="ckfRenameFolderModal" aria-hidden="true">
		<div class="ckf-modal" role="dialog">
			<div class="ckf-modal__head">Đổi tên thư mục</div>
			<div class="ckf-modal__body">
				<p class="ckf-newfolder-hint">Đang đổi: <strong>@MediaFolders.Label(folder)</strong></p>
				<label style="font-size:13px;display:block;margin-bottom:8px;">Tên mới:</label>
				<input type="text" class="form-control" id="ckfRenameFolderInput" maxlength="60" value="@MediaFolders.LeafLabel(folder)" />
			</div>
			<div class="ckf-modal__foot">
				<button type="button" class="btn btn-default" data-close-modal="ckfRenameFolderModal">Cancel</button>
				<button type="button" class="btn btn-success" id="ckfRenameFolderOk">OK</button>
			</div>
		</div>
	</div>

	@* Move folder *@
	<div class="ckf-modal-backdrop" id="ckfMoveFolderModal" aria-hidden="true">
		<div class="ckf-modal" role="dialog">
			<div class="ckf-modal__head">Chuyển thư mục vào…</div>
			<div class="ckf-modal__body">
				<p class="ckf-newfolder-hint">Đang chuyển: <strong>@MediaFolders.Label(folder)</strong></p>
				<ul class="ckf-folder-list" id="ckfMoveFolderList">
					<li>
						<button type="button" data-parent="" class="@(folder == MediaFolders.All ? null : null)">
							<i class="fa fa-folder-open-o"></i> Gốc (Tất cả)
						</button>
					</li>
					@foreach (var item in Model.FolderList)
					{
						var blocked = item.Key == folder
							|| item.Key.StartsWith(folder + "/", StringComparison.OrdinalIgnoreCase);
						if (blocked) { continue; }
						var pad = Math.Max(0, item.Depth) * 14;
						<li>
							<button type="button" data-parent="@item.Key" style="padding-left:@(12 + pad)px">
								<i class="fa @(item.Depth > 0 ? "fa-folder-o" : "fa-folder")"></i> @item.Label
							</button>
						</li>
					}
				</ul>
			</div>
			<div class="ckf-modal__foot">
				<button type="button" class="btn btn-default" data-close-modal="ckfMoveFolderModal">Cancel</button>
				<button type="button" class="btn btn-success" id="ckfMoveFolderOk">OK</button>
			</div>
		</div>
	</div>

