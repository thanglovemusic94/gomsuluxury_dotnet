	<div class="ckf-toast" id="ckfToast" role="status" aria-live="polite"></div>

	<script>
		(function () {
			var toastEl = document.getElementById('ckfToast');
			var toastTimer;
			function showToast(html) {
				toastEl.innerHTML = html;
				toastEl.classList.add('is-show');
				clearTimeout(toastTimer);
				toastTimer = setTimeout(function () { toastEl.classList.remove('is-show'); }, 2200);
			}

			var grid = document.getElementById('ckfGrid');
			var isPicker = document.getElementById('ckfToolbar').getAttribute('data-picker') === '1';
			var funcNum = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CKEditorFuncNum));
			var inputId = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.InputId));
			var cards = grid ? Array.prototype.slice.call(grid.querySelectorAll('.ckf-card:not(.ckf-card--folder)')) : [];
			var folderMode = 'copy';
			var folderTarget = '';
			var viewerIndex = 0;

			var elChoose = document.getElementById('ckfChoose');
			var elChooseResized = document.getElementById('ckfChooseResized');
			var elView = document.getElementById('ckfView');
			var elDownload = document.getElementById('ckfDownload');
			var elEdit = document.getElementById('ckfEdit');
			var elCopy = document.getElementById('ckfCopy');
			var elMove = document.getElementById('ckfMove');
			var elRename = document.getElementById('ckfRename');
			var elDelete = document.getElementById('ckfDelete');
			var elCount = document.getElementById('ckfCount');
			var uploadInput = document.getElementById('ckfUploadInput');
			var uploadForm = document.getElementById('ckfUploadForm');

			function selectedCards() { return cards.filter(function (c) { return c.classList.contains('is-picked'); }); }
			function urlOf(card, size) {
				if (!card) return '';
				if (size === 'thumb') return card.getAttribute('data-thumb') || '';
				if (size === 'large') return card.getAttribute('data-large') || '';
				if (size === 'original') return card.getAttribute('data-original') || '';
				if (size === 'medium') return card.getAttribute('data-medium') || '';
				return card.getAttribute('data-url') || card.getAttribute('data-medium') || '';
			}
			function openModal(id) {
				var m = document.getElementById(id);
				if (!m) return;
				m.classList.add('is-on');
				m.setAttribute('aria-hidden', 'false');
			}
			function closeModal(id) {
				var m = document.getElementById(id);
				if (!m) return;
				m.classList.remove('is-on');
				m.setAttribute('aria-hidden', 'true');
			}
			document.querySelectorAll('[data-close-modal]').forEach(function (btn) {
				btn.addEventListener('click', function () { closeModal(btn.getAttribute('data-close-modal')); });
			});
			document.querySelectorAll('.ckf-modal-backdrop').forEach(function (backdrop) {
				backdrop.addEventListener('click', function (e) {
					if (e.target === backdrop) closeModal(backdrop.id);
				});
			});

			function syncToolbar() {
				var selected = selectedCards();
				var n = selected.length;
				var one = n === 1 ? selected[0] : null;
				elCount.textContent = n + ' chọn';
				if (elChoose) {
					elChoose.disabled = n === 0;
					elChoose.innerHTML = n > 1 ? '<i class="fa fa-check"></i> Chọn ' + n : '<i class="fa fa-check"></i> Chọn';
				}
				if (elChooseResized) elChooseResized.disabled = n !== 1;
				elView.disabled = n === 0;
				elCopy.disabled = n === 0 || selected.every(function (c) { return !(+c.getAttribute('data-id') > 0); });
				elMove.disabled = elCopy.disabled;
				elRename.disabled = n !== 1 || !(+ (one && one.getAttribute('data-id')) > 0);
				elDelete.disabled = elCopy.disabled;

				if (one) {
					var orig = urlOf(one, 'original') || urlOf(one);
					elDownload.classList.remove('disabled');
					elDownload.href = orig;
					elEdit.classList.remove('disabled');
					elEdit.href = '/Admin/Media?Q=' + encodeURIComponent(one.getAttribute('data-name') || '');
				} else {
					elDownload.classList.add('disabled');
					elDownload.href = '#';
					elEdit.classList.add('disabled');
					elEdit.href = '#';
				}
			}
			function selectOnly(card) {
				cards.forEach(function (c) { c.classList.toggle('is-picked', c === card); });
				syncToolbar();
			}
			function toggle(card) {
				card.classList.toggle('is-picked');
				syncToolbar();
			}
			function clearSelection() {
				cards.forEach(function (c) { c.classList.remove('is-picked'); });
				syncToolbar();
			}

			function pickUrls(urls) {
				urls = (urls || []).filter(Boolean);
				if (!urls.length) return;
				if (inputId && window.opener && window.opener.document) {
					var el = window.opener.document.getElementById(inputId);
					if (el) {
						el.value = urls[0];
						el.dispatchEvent(new Event('input', { bubbles: true }));
						el.dispatchEvent(new Event('change', { bubbles: true }));
					}
					window.close();
					return;
				}
				if (funcNum && window.opener && window.opener.CKEDITOR) {
					if (urls.length === 1) {
						window.opener.CKEDITOR.tools.callFunction(funcNum, urls[0]);
						window.close();
						return;
					}
					var editor = window.opener.CKEDITOR.currentInstance;
					if (editor && editor.insertHtml) {
						editor.insertHtml(urls.map(function (u) {
							return '<p><img src="' + u.replace(/"/g, '&quot;') + '" alt="" /></p>';
						}).join(''));
						window.close();
						return;
					}
					window.opener.CKEDITOR.tools.callFunction(funcNum, urls[0]);
					window.close();
				}
			}

			function fillIds(container, list) {
				container.innerHTML = '';
				list.forEach(function (card) {
					var id = parseInt(card.getAttribute('data-id') || '0', 10);
					if (!(id > 0)) return;
					var input = document.createElement('input');
					input.type = 'hidden';
					input.name = 'ids';
					input.value = String(id);
					container.appendChild(input);
				});
			}

			function customUrl(card, w) {
				var original = urlOf(card, 'original');
				if (!original) return urlOf(card, 'medium');
				w = Math.max(16, Math.min(1600, parseInt(w, 10) || 800));
				var base = original.indexOf('?') >= 0 ? original.split('?')[0] : original;
				// Map optimized → originals for ImageSharp when possible
				base = base
					.replace('/uploads/optimized/thumb/', '/uploads/originals/')
					.replace('/uploads/optimized/medium/', '/uploads/originals/')
					.replace('/uploads/optimized/large/', '/uploads/originals/')
					.replace('/uploads/optimized/icon/', '/uploads/originals/')
					.replace(/\.webp$/i, function () { return '.jpg'; });
				return base + '?width=' + w + '&rmode=max&format=webp&quality=70';
			}

			cards.forEach(function (card) {
				card.addEventListener('click', function (e) {
					if (e.ctrlKey || e.metaKey) toggle(card);
					else selectOnly(card);
				});
				card.addEventListener('dblclick', function (e) {
					e.preventDefault();
					selectOnly(card);
					if (isPicker) pickUrls([urlOf(card)]);
					else openViewerAt(cards.indexOf(card));
				});
				card.addEventListener('keydown', function (e) {
					if (e.key === 'Enter') {
						e.preventDefault();
						if (isPicker) pickUrls([urlOf(card)]);
						else openViewerAt(cards.indexOf(card));
					}
					if (e.key === ' ') {
						e.preventDefault();
						if (e.ctrlKey || e.metaKey) toggle(card);
						else selectOnly(card);
					}
				});
			});

			if (uploadInput && uploadForm) {
				uploadInput.addEventListener('change', function () {
					if (!uploadInput.files || !uploadInput.files.length) return;
					// move files into form via DataTransfer clone of input already bound with form=
					uploadForm.submit();
				});
			}

			if (elChoose) elChoose.addEventListener('click', function () {
				pickUrls(selectedCards().map(function (c) { return urlOf(c); }));
			});

			if (elChooseResized) {
				elChooseResized.addEventListener('click', function () {
					if (selectedCards().length !== 1) return;
					openModal('ckfResizeModal');
					syncCustomSize();
				});
			}
			function syncCustomSize() {
				var custom = document.querySelector('input[name="ckfResize"][value="custom"]');
				document.getElementById('ckfCustomSize').classList.toggle('is-on', !!(custom && custom.checked));
			}
			document.querySelectorAll('input[name="ckfResize"]').forEach(function (r) {
				r.addEventListener('change', syncCustomSize);
			});
			document.getElementById('ckfResizeOk').addEventListener('click', function () {
				var one = selectedCards()[0];
				if (!one) return;
				var mode = (document.querySelector('input[name="ckfResize"]:checked') || {}).value || 'medium';
				var url = mode === 'custom'
					? customUrl(one, document.getElementById('ckfCustomW').value)
					: urlOf(one, mode);
				closeModal('ckfResizeModal');
				pickUrls([url]);
			});

			function openFolderModal(mode) {
				folderMode = mode;
				folderTarget = '';
				document.getElementById('ckfFolderTitle').textContent = mode === 'move' ? 'Move File To...' : 'Copy File To...';
				document.querySelectorAll('#ckfFolderList button').forEach(function (b) { b.classList.remove('is-on'); });
				openModal('ckfFolderModal');
			}
			document.querySelectorAll('#ckfFolderList button').forEach(function (btn) {
				btn.addEventListener('click', function () {
					document.querySelectorAll('#ckfFolderList button').forEach(function (b) { b.classList.remove('is-on'); });
					btn.classList.add('is-on');
					folderTarget = btn.getAttribute('data-folder') || '';
				});
				btn.addEventListener('dblclick', function () {
					folderTarget = btn.getAttribute('data-folder') || '';
					document.getElementById('ckfFolderOk').click();
				});
			});
			function submitFolderAction() {
				if (!folderTarget) { showToast('Chọn thư mục đích.'); return; }
				var list = selectedCards().filter(function (c) { return +c.getAttribute('data-id') > 0; });
				if (!list.length) {
					showToast('File này không có id (legacy) — không Move/Copy được.');
					return;
				}
				if (folderMode === 'move') {
					document.getElementById('ckfBulkFolderValue').value = folderTarget;
					fillIds(document.getElementById('ckfBulkFolderIds'), list);
					document.getElementById('ckfBulkFolderForm').submit();
				} else {
					document.getElementById('ckfBulkCopyValue').value = folderTarget;
					fillIds(document.getElementById('ckfBulkCopyIds'), list);
					document.getElementById('ckfBulkCopyForm').submit();
				}
			}
			document.getElementById('ckfFolderOk').addEventListener('click', submitFolderAction);
			elCopy.addEventListener('click', function () { openFolderModal('copy'); });
			elMove.addEventListener('click', function () { openFolderModal('move'); });

			document.getElementById('ckfNewFolder').addEventListener('click', function () {
				document.getElementById('ckfNewFolderInput').value = '';
				openModal('ckfNewFolderModal');
				setTimeout(function () { document.getElementById('ckfNewFolderInput').focus(); }, 30);
			});
			document.getElementById('ckfNewFolderOk').addEventListener('click', function () {
				var name = (document.getElementById('ckfNewFolderInput').value || '').trim();
				if (!name) { showToast('Nhập tên thư mục.'); return; }
				document.getElementById('ckfNewFolderName').value = name;
				document.getElementById('ckfCreateFolderForm').submit();
			});
			document.getElementById('ckfNewFolderInput').addEventListener('keydown', function (e) {
				if (e.key === 'Enter') {
					e.preventDefault();
					document.getElementById('ckfNewFolderOk').click();
				}
			});
			var elDeleteFolder = document.getElementById('ckfDeleteFolder');
			if (elDeleteFolder) {
				elDeleteFolder.addEventListener('click', function () {
					if (elDeleteFolder.disabled) return;
					openModal('ckfDeleteFolderModal');
				});
			}
			document.getElementById('ckfDeleteFolderOk').addEventListener('click', function () {
				document.getElementById('ckfDeleteFolderForm').submit();
			});

			var elRenameFolder = document.getElementById('ckfRenameFolder');
			if (elRenameFolder) {
				elRenameFolder.addEventListener('click', function () {
					if (elRenameFolder.disabled) return;
					openModal('ckfRenameFolderModal');
					setTimeout(function () {
						var inp = document.getElementById('ckfRenameFolderInput');
						if (inp) { inp.focus(); inp.select(); }
					}, 30);
				});
			}
			document.getElementById('ckfRenameFolderOk').addEventListener('click', function () {
				var name = (document.getElementById('ckfRenameFolderInput').value || '').trim();
				if (!name) { showToast('Nhập tên thư mục.'); return; }
				document.getElementById('ckfRenameFolderName').value = name;
				document.getElementById('ckfRenameFolderForm').submit();
			});
			document.getElementById('ckfRenameFolderInput').addEventListener('keydown', function (e) {
				if (e.key === 'Enter') {
					e.preventDefault();
					document.getElementById('ckfRenameFolderOk').click();
				}
			});

			var moveFolderParent = '';
			var elMoveFolder = document.getElementById('ckfMoveFolder');
			if (elMoveFolder) {
				elMoveFolder.addEventListener('click', function () {
					if (elMoveFolder.disabled) return;
					moveFolderParent = '';
					document.querySelectorAll('#ckfMoveFolderList button').forEach(function (b) { b.classList.remove('is-on'); });
					openModal('ckfMoveFolderModal');
				});
			}
			document.querySelectorAll('#ckfMoveFolderList button').forEach(function (btn) {
				btn.addEventListener('click', function () {
					document.querySelectorAll('#ckfMoveFolderList button').forEach(function (b) { b.classList.remove('is-on'); });
					btn.classList.add('is-on');
					moveFolderParent = btn.getAttribute('data-parent') || '';
				});
				btn.addEventListener('dblclick', function () {
					moveFolderParent = btn.getAttribute('data-parent') || '';
					document.getElementById('ckfMoveFolderOk').click();
				});
			});
			document.getElementById('ckfMoveFolderOk').addEventListener('click', function () {
				document.getElementById('ckfMoveFolderParent').value = moveFolderParent;
				document.getElementById('ckfMoveFolderForm').submit();
			});

			elRename.addEventListener('click', function () {
				var one = selectedCards()[0];
				if (!one) return;
				document.getElementById('ckfRenameInput').value = one.getAttribute('data-name') || '';
				openModal('ckfRenameModal');
				setTimeout(function () {
					var inp = document.getElementById('ckfRenameInput');
					inp.focus();
					inp.select();
				}, 30);
			});
			document.getElementById('ckfRenameOk').addEventListener('click', function () {
				var one = selectedCards()[0];
				var name = (document.getElementById('ckfRenameInput').value || '').trim();
				if (!one || !name) return;
				document.getElementById('ckfRenameId').value = one.getAttribute('data-id') || '0';
				document.getElementById('ckfRenameName').value = name;
				document.getElementById('ckfRenameForm').submit();
			});

			elDelete.addEventListener('click', function () {
				var list = selectedCards().filter(function (c) { return +c.getAttribute('data-id') > 0; });
				if (!list.length) return;
				if (!confirm('Chuyển ' + list.length + ' file vào thùng rác?')) return;
				fillIds(document.getElementById('ckfBulkDeleteIds'), list);
				document.getElementById('ckfBulkDeleteForm').submit();
			});

			function openViewerAt(index) {
				if (!cards.length) return;
				viewerIndex = (index + cards.length) % cards.length;
				var card = cards[viewerIndex];
				var img = document.getElementById('ckfViewerImg');
				img.src = urlOf(card, 'large') || urlOf(card, 'medium') || urlOf(card);
				img.alt = card.getAttribute('data-name') || '';
				document.getElementById('ckfViewerMeta').textContent =
					(card.getAttribute('data-name') || '') + ' · ' + (viewerIndex + 1) + ' / ' + cards.length;
				document.getElementById('ckfViewer').classList.add('is-on');
				selectOnly(card);
			}
			elView.addEventListener('click', function () {
				var selected = selectedCards();
				if (!selected.length) return;
				openViewerAt(cards.indexOf(selected[0]));
			});
			document.getElementById('ckfViewerClose').addEventListener('click', function () {
				document.getElementById('ckfViewer').classList.remove('is-on');
			});
			document.getElementById('ckfViewerPrev').addEventListener('click', function () { openViewerAt(viewerIndex - 1); });
			document.getElementById('ckfViewerNext').addEventListener('click', function () { openViewerAt(viewerIndex + 1); });
			document.getElementById('ckfViewer').addEventListener('click', function (e) {
				if (e.target.id === 'ckfViewer') document.getElementById('ckfViewer').classList.remove('is-on');
			});

			document.addEventListener('keydown', function (e) {
				if (e.key === 'Escape') {
					clearSelection();
					closeModal('ckfResizeModal');
					closeModal('ckfFolderModal');
					closeModal('ckfRenameModal');
					closeModal('ckfNewFolderModal');
					closeModal('ckfDeleteFolderModal');
					closeModal('ckfRenameFolderModal');
					closeModal('ckfMoveFolderModal');
					document.getElementById('ckfViewer').classList.remove('is-on');
				}
				if (document.getElementById('ckfViewer').classList.contains('is-on')) {
					if (e.key === 'ArrowLeft') openViewerAt(viewerIndex - 1);
					if (e.key === 'ArrowRight') openViewerAt(viewerIndex + 1);
				}
			});

			syncToolbar();
		})();
	</script>
</body>
</html>
