@page "/Admin/Media"
@model WebShop.Pages.Admin.Media.IndexModel
@using WebShop.Infrastructure
@{
	ViewData["Title"] = "Thư viện media";
	ViewData["Menu"] = "Media";
	var data = Model.PageData;
	var folder = MediaFolders.Normalize(Model.Folder);
	string SizeLabel(long bytes) => bytes < 1024 * 1024
		? $"{bytes / 1024.0:0.#} KB"
		: $"{bytes / (1024.0 * 1024):0.##} MB";
	var pageSize = AdminPaging.NormalizeSize(Model.PageSize);
	var missing = Model.MissingAlt ? "1" : null;
	var maxMb = Math.Max(1, Model.MaxUploadBytes / (1024 * 1024));
	string PageUrl(int n, int size = 0) =>
		AdminPaging.BuildUrl("/Admin/Media", n, size > 0 ? size : pageSize,
			("Type", Model.Type),
			("Folder", folder),
			("Q", Model.Q),
			("MissingAlt", missing));
	string FolderUrl(string f) =>
		AdminPaging.BuildUrl("/Admin/Media", 1, pageSize,
			("Type", Model.Type),
			("Folder", f),
			("Q", Model.Q),
			("MissingAlt", missing));
}

<div class="page-header">
	<h1>
		Thư viện media
		<small><i class="ace-icon fa fa-angle-double-right"></i> grid · panel · upload kéo thả</small>
	</h1>
</div>
<form method="post" accept-charset="utf-8" style="display:none" aria-hidden="true">@Html.AntiForgeryToken()</form>
<partial name="_AdminAlerts" />

<div class="row media-lib">
	<div class="col-sm-3 media-side">
		<div class="widget-box">
			<div class="widget-header"><h4 class="widget-title">Thư mục</h4></div>
			<div class="widget-body"><div class="widget-main" style="padding:8px 0;">
				<ul class="nav nav-list" style="margin:0;">
					<li class="@(folder == MediaFolders.All ? "active" : null)">
						<a href="@FolderUrl("")">
							<i class="menu-icon fa fa-folder-open-o"></i>
							Tất cả
							<span class="badge badge-info pull-right">@(data.FolderCounts.GetValueOrDefault(MediaFolders.All))</span>
						</a>
					</li>
					@foreach (var item in MediaFolders.Items)
					{
						<li class="@(folder == item.Key ? "active" : null)">
							<a href="@FolderUrl(item.Key)">
								<i class="menu-icon fa fa-folder-o"></i>
								@item.Label
								<span class="badge pull-right">@(data.FolderCounts.GetValueOrDefault(item.Key))</span>
							</a>
						</li>
					}
				</ul>
			</div></div>
		</div>
	</div>

	<div class="col-sm-9">
		<div class="widget-box">
			<div class="widget-header"><h4 class="widget-title">Tải lên → @MediaFolders.Label(folder == MediaFolders.All ? MediaFolders.Other : folder)</h4></div>
			<div class="widget-body"><div class="widget-main">
				<div class="form-inline" style="margin-bottom:10px;">
					<label style="margin-right:8px;">Thư mục đích</label>
					<select id="mediaUploadFolder" class="form-control input-sm">
						@foreach (var item in MediaFolders.Items)
						{
							var selected = folder == item.Key || (folder == MediaFolders.All && item.Key == MediaFolders.Other);
							if (selected) { <option value="@item.Key" selected>@item.Label</option> }
							else { <option value="@item.Key">@item.Label</option> }
						}
					</select>
					<input type="text" id="mediaUploadAlt" class="form-control input-sm" maxlength="255" placeholder="Alt SEO (tuỳ chọn)" style="min-width:200px;margin-left:8px;" />
				</div>
				<div class="media-drop" id="mediaDrop" tabindex="0" role="button" aria-label="Kéo thả hoặc chọn file">
					<p class="media-drop__hint"><i class="fa fa-cloud-upload"></i> Kéo thả ảnh vào đây, hoặc bấm để chọn nhiều file</p>
					<p class="media-drop__meta">Tên file tự slugify · tối đa @maxMb MB/file · jpg/png/webp/gif/svg/pdf…</p>
					<input type="file" id="mediaFileInput" multiple accept="image/*,.pdf,.zip,.doc,.docx" style="display:none" />
				</div>
				<div class="media-upload-progress" id="mediaUploadProgress">
					<div class="media-upload-progress__bar"><span id="mediaUploadBar"></span></div>
					<div class="media-upload-progress__text" id="mediaUploadText">Đang tải…</div>
				</div>
			</div></div>
		</div>

		<div class="widget-box">
			<div class="widget-header">
				<h4 class="widget-title">
					@MediaFolders.Label(folder)
					<span class="badge badge-info">@data.TotalCount</span>
				</h4>
				<div class="widget-toolbar">
					<a class="btn btn-xs @(Model.Type == "Files" ? "btn-primary" : "btn-default")" href="@AdminPaging.BuildUrl("/Admin/Media", 1, pageSize, ("Type", "Files"), ("Folder", folder), ("Q", Model.Q), ("MissingAlt", missing))">Tất cả loại</a>
					<a class="btn btn-xs @(Model.Type == "Images" ? "btn-primary" : "btn-default")" href="@AdminPaging.BuildUrl("/Admin/Media", 1, pageSize, ("Type", "Images"), ("Folder", folder), ("Q", Model.Q), ("MissingAlt", missing))">Ảnh</a>
					<form method="post" asp-page-handler="RegenerateAll" class="inline" style="display:inline" onsubmit="return confirm('Tạo lại tối ưu cho mọi ảnh?');">
						<input type="hidden" name="Type" value="@Model.Type" />
						<input type="hidden" name="Folder" value="@folder" />
						<input type="hidden" name="PageNumber" value="@data.Page" />
						<input type="hidden" name="PageSize" value="@pageSize" />
						<input type="hidden" name="Q" value="@Model.Q" />
						<button type="submit" class="btn btn-xs btn-warning">Tạo lại tất cả tối ưu</button>
					</form>
				</div>
			</div>
			<div class="widget-body"><div class="widget-main">
				<form method="get" class="form-inline media-search" style="margin-bottom:12px;display:flex;flex-wrap:wrap;gap:8px;align-items:center;">
					<input type="hidden" name="Type" value="@Model.Type" />
					<input type="hidden" name="Folder" value="@folder" />
					<input type="hidden" name="PageSize" value="@pageSize" />
					<input type="text" name="Q" value="@Model.Q" class="form-control input-sm" placeholder="Tìm theo tên ảnh hoặc Alt..." style="min-width:260px;flex:1;" />
					<label class="checkbox-inline" style="margin:0;">
						<input type="checkbox" name="MissingAlt" value="true" @(Model.MissingAlt ? "checked" : null) /> Thiếu Alt
					</label>
					<button type="submit" class="btn btn-sm btn-primary"><i class="fa fa-search"></i> Lọc</button>
					@if (!string.IsNullOrWhiteSpace(Model.Q) || Model.MissingAlt)
					{
						<a class="btn btn-sm btn-link" href="@AdminPaging.BuildUrl("/Admin/Media", 1, pageSize, ("Type", Model.Type), ("Folder", folder))">Xóa lọc</a>
					}
				</form>
				@{
					var mediaPager = new AdminPagerModel {
						PageNumber = data.Page,
						PageSize = data.PageSize,
						TotalCount = data.TotalCount,
						TotalPages = data.TotalPages,
						PageUrl = PageUrl
					};
				}
				<partial name="_AdminPager" model="mediaPager" />

				@if (data.Items.Count == 0)
				{
					<div class="media-empty">
						<i class="fa fa-picture-o fa-2x" style="margin-bottom:8px;display:block;opacity:.5;"></i>
						Không có file khớp bộ lọc. Hãy tải lên hoặc đổi thư mục.
					</div>
				}
				else
				{
					<div class="media-bulk">
						<label class="checkbox-inline" style="margin:0;">
							<input type="checkbox" id="mediaSelectPage" /> Chọn trang
						</label>
						<span class="media-bulk__count" id="mediaSelectedCount">0 đã chọn</span>
						<button type="button" class="btn btn-sm btn-success" id="mediaSeoBtn" disabled>
							<i class="fa fa-magic"></i> Tối ưu SEO
						</button>
						<form method="post" asp-page-handler="BulkFolder" id="mediaBulkFolderForm" class="form-inline" style="display:inline-flex;gap:6px;align-items:center;margin:0;">
							<input type="hidden" name="Type" value="@Model.Type" />
							<input type="hidden" name="Folder" value="@folder" />
							<input type="hidden" name="PageNumber" value="@data.Page" />
							<input type="hidden" name="PageSize" value="@pageSize" />
							<input type="hidden" name="Q" value="@Model.Q" />
							<div id="mediaBulkFolderIds"></div>
							<select name="folder" class="form-control input-sm" id="mediaBulkFolderSelect">
								@foreach (var f in MediaFolders.Items)
								{
									<option value="@f.Key">@f.Label</option>
								}
							</select>
							<button type="submit" class="btn btn-sm btn-info" id="mediaBulkFolderBtn" disabled>Đổi thư mục</button>
						</form>
						<form method="post" asp-page-handler="BulkDelete" id="mediaBulkDeleteForm" class="inline" style="display:inline;margin:0;" onsubmit="return confirm('Chuyển các ảnh đã chọn vào thùng rác?');">
							<input type="hidden" name="Type" value="@Model.Type" />
							<input type="hidden" name="Folder" value="@folder" />
							<input type="hidden" name="PageNumber" value="@data.Page" />
							<input type="hidden" name="PageSize" value="@pageSize" />
							<input type="hidden" name="Q" value="@Model.Q" />
							<div id="mediaBulkDeleteIds"></div>
							<button type="submit" class="btn btn-sm btn-danger" id="mediaBulkDeleteBtn" disabled>Xóa</button>
						</form>
					</div>

					<div class="media-workspace" id="mediaWorkspace">
						<div class="media-grid" id="mediaGrid">
							@foreach (var item in data.Items)
							{
								var previewUrl = item.IsImage ? (item.MediumUrl ?? item.ThumbUrl ?? item.OriginalUrl) : "";
								var useCount = item.Id > 0 && Model.UsageCounts.TryGetValue(item.Id, out var uc) ? uc : 0;
								var missingAlt = string.IsNullOrWhiteSpace(item.Alt);
								var ext = System.IO.Path.GetExtension(item.Name).TrimStart('.').ToUpperInvariant();
								if (string.IsNullOrEmpty(ext)) { ext = item.IsImage ? "IMG" : "FILE"; }
								<div class="media-card"
									 data-id="@item.Id"
									 data-name="@item.Name"
									 data-alt="@(item.Alt ?? "")"
									 data-folder="@item.Folder"
									 data-folder-label="@MediaFolders.Label(item.Folder)"
									 data-size="@SizeLabel(item.Size)"
									 data-usage="@useCount"
									 data-thumb="@item.ThumbUrl"
									 data-medium="@item.MediumUrl"
									 data-large="@item.LargeUrl"
									 data-original="@item.OriginalUrl"
									 data-preview="@previewUrl"
									 data-image="@(item.IsImage ? "1" : "0")"
									 data-otf="@MediaDynamicUrls.For(item.OriginalUrl, 800)">
									<div class="media-card__preview">
										@if (item.Id > 0)
										{
											<input type="checkbox" class="media-card__check js-media-pick" value="@item.Id" aria-label="Chọn" />
										}
										<span class="media-card__badge @(missingAlt && item.IsImage ? "is-warn" : null)">@(missingAlt && item.IsImage ? "No Alt" : ext)</span>
										@if (item.IsImage)
										{
											<img src="@(item.ThumbUrl ?? item.OriginalUrl)" alt="@(item.Alt ?? item.Name)" loading="lazy" />
										}
										else
										{
											<i class="fa fa-file-o fa-2x text-muted"></i>
										}
									</div>
									<div class="media-card__body">
										<div class="media-card__name" title="@(item.Alt ?? item.Name)">@(string.IsNullOrWhiteSpace(item.Alt) ? item.Name : item.Alt)</div>
										<div class="media-card__meta">@MediaFolders.Label(item.Folder) · @SizeLabel(item.Size)</div>
									</div>
								</div>
							}
						</div>

						<aside class="media-drawer" id="mediaDrawer" aria-hidden="true">
							<div class="media-drawer__head">
								<h3 id="drawerTitle">Chi tiết</h3>
								<button type="button" class="btn btn-xs btn-default" id="mediaDrawerClose" title="Đóng"><i class="fa fa-times"></i></button>
							</div>
							<div class="media-drawer__preview" id="drawerPreview"><span class="text-muted">Chọn một ảnh</span></div>
							<div class="media-drawer__sizes" id="drawerSizes"></div>
							<div class="media-drawer__usage" id="drawerUsage"></div>
							<form method="post" asp-page-handler="Alt" id="drawerAltForm">
								<input type="hidden" name="Type" value="@Model.Type" />
								<input type="hidden" name="Folder" value="@folder" />
								<input type="hidden" name="PageNumber" value="@data.Page" />
								<input type="hidden" name="PageSize" value="@pageSize" />
								<input type="hidden" name="Q" value="@Model.Q" />
								<input type="hidden" name="id" id="drawerAltId" value="0" />
								<div class="form-group">
									<label for="drawerAltInput">Alt SEO</label>
									<input type="text" name="alt" id="drawerAltInput" class="form-control input-sm" maxlength="255" />
								</div>
								<button type="submit" class="btn btn-sm btn-primary btn-block">Lưu Alt</button>
							</form>
							<form method="post" asp-page-handler="Folder" id="drawerFolderForm" style="margin-top:10px;">
								<input type="hidden" name="Type" value="@Model.Type" />
								<input type="hidden" name="Folder" value="@folder" />
								<input type="hidden" name="PageNumber" value="@data.Page" />
								<input type="hidden" name="PageSize" value="@pageSize" />
								<input type="hidden" name="Q" value="@Model.Q" />
								<input type="hidden" name="id" id="drawerFolderId" value="0" />
								<div class="form-group">
									<label for="drawerFolderSelect">Thư mục</label>
									<select name="folder" id="drawerFolderSelect" class="form-control input-sm">
										@foreach (var f in MediaFolders.Items)
										{
											<option value="@f.Key">@f.Label</option>
										}
									</select>
								</div>
								<button type="submit" class="btn btn-sm btn-default btn-block">Đổi thư mục</button>
							</form>
							<form method="post" asp-page-handler="Regenerate" id="drawerRegenForm" style="margin-top:10px;">
								<input type="hidden" name="Type" value="@Model.Type" />
								<input type="hidden" name="Folder" value="@folder" />
								<input type="hidden" name="PageNumber" value="@data.Page" />
								<input type="hidden" name="PageSize" value="@pageSize" />
								<input type="hidden" name="Q" value="@Model.Q" />
								<input type="hidden" name="id" id="drawerRegenId" value="0" />
								<button type="submit" class="btn btn-sm btn-warning btn-block">Tạo lại tối ưu</button>
							</form>
							<form method="post" asp-page-handler="Delete" id="drawerDeleteForm" style="margin-top:10px;" onsubmit="return confirm(this.getAttribute('data-confirm') || 'Chuyển vào thùng rác?');">
								<input type="hidden" name="Type" value="@Model.Type" />
								<input type="hidden" name="Folder" value="@folder" />
								<input type="hidden" name="PageNumber" value="@data.Page" />
								<input type="hidden" name="PageSize" value="@pageSize" />
								<input type="hidden" name="Q" value="@Model.Q" />
								<input type="hidden" name="id" id="drawerDeleteId" value="0" />
								<input type="hidden" name="fileName" id="drawerDeleteName" value="" />
								<button type="submit" class="btn btn-sm btn-danger btn-block">Xóa</button>
							</form>
							<button type="button" class="btn btn-sm btn-link btn-block" id="drawerUsageBtn" style="margin-top:6px;">Đang dùng ở đâu?</button>
						</aside>
					</div>
				}
			</div></div>
		</div>
	</div>
</div>

<div class="media-toast" id="mediaToast" role="status" aria-live="polite"></div>
<div class="media-seo-modal" id="mediaSeoModal" aria-hidden="true">
	<div class="media-seo-modal__panel" role="dialog" aria-modal="true" aria-labelledby="mediaSeoTitle">
		<div class="media-seo-modal__head">
			<div>
				<h3 id="mediaSeoTitle" style="margin:0;font-size:16px;">Xem trước tối ưu SEO</h3>
				<small class="text-muted">Sửa tên/alt nếu cần, bỏ tick ảnh không muốn đổi</small>
			</div>
			<button type="button" class="btn btn-sm btn-default js-seo-close"><i class="fa fa-times"></i></button>
		</div>
		<div class="media-seo-modal__body">
			<table class="table table-striped media-seo-table">
				<thead>
					<tr>
						<th style="width:36px;"><input type="checkbox" id="mediaSeoSelectAll" title="Chọn tất cả" checked /></th>
						<th style="width:60px;">Ảnh</th>
						<th>Tên cũ → mới</th>
						<th>Alt mới</th>
						<th style="width:90px;">Nguồn</th>
					</tr>
				</thead>
				<tbody id="mediaSeoRows"></tbody>
			</table>
		</div>
		<div class="media-seo-modal__foot">
			<span class="text-muted" id="mediaSeoStatus"></span>
			<div>
				<button type="button" class="btn btn-default js-seo-close">Hủy</button>
				<button type="button" class="btn btn-success" id="mediaSeoApply"><i class="fa fa-check"></i> Áp dụng</button>
			</div>
		</div>
	</div>
</div>

@section Scripts {
	<script src="~/js/admin-media.js" asp-append-version="true"></script>
}
