@page
@model WebShop.Pages.Admin.Categories.IndexModel
@{
    ViewData["Title"] = "Danh mục";
    ViewData["Menu"] = "Categories";
}

<div class="page-header">
	<h1>
		Danh mục
		<small><i class="ace-icon fa fa-angle-double-right"></i> sản phẩm và blog</small>
		<a href="/Admin/Categories/Edit" class="btn btn-sm btn-primary pull-right">Thêm danh mục</a>
	</h1>
</div>
<partial name="_AdminAlerts" />

<div class="widget-box">
	<div class="widget-body">
		<div class="widget-main no-padding">
			<table class="table table-striped table-bordered table-hover">
				<thead>
					<tr><th>Tên</th><th>Slug</th><th>Loại</th><th>Danh mục cha</th><th></th></tr>
				</thead>
				<tbody>
				@if (Model.Items.Count == 0)
				{
					<tr><td colspan="5">Chưa có danh mục.</td></tr>
				}
				@foreach (var category in Model.Items)
				{
					<tr>
						<td>@category.Name</td>
						<td>@category.Slug</td>
						<td>@category.Type</td>
						<td>@category.Parent?.Name</td>
						<td class="text-right">
							<a class="btn btn-xs btn-info" href="/Admin/Categories/Edit/@category.Id">Sửa</a>
							<form method="post" asp-page-handler="Delete" asp-route-id="@category.Id" class="inline" onsubmit="return confirm('Xóa danh mục này?');">
								<button type="submit" class="btn btn-xs btn-danger">Xóa</button>
							</form>
						</td>
					</tr>
				}
				</tbody>
			</table>
		</div>
</div>
</div>
