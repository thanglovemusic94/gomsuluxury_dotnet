@page "{id:int?}"
@model WebShop.Pages.Admin.Categories.EditModel
@{
    ViewData["Title"] = Model.Input.Id == 0 ? "Thêm danh mục" : "Sửa danh mục";
    ViewData["Menu"] = "Categories";
}

<div class="page-header"><h1>@ViewData["Title"]</h1></div>
<partial name="_AdminAlerts" />

<form method="post" class="form-horizontal">
	<input asp-for="Input.Id" type="hidden" />
	<div class="widget-box">
		<div class="widget-header"><h4 class="widget-title">Danh mục</h4></div>
		<div class="widget-body"><div class="widget-main">
			<div class="form-group">
				<label class="col-sm-3 control-label">Tên</label>
				<div class="col-sm-9"><input asp-for="Input.Name" class="form-control" maxlength="100" /></div>
			</div>
			<div class="form-group">
				<label class="col-sm-3 control-label">Slug</label>
				<div class="col-sm-9">
					<input asp-for="Input.Slug" class="form-control" maxlength="150" />
					<span class="help-block">Để trống để tạo từ tên.</span>
				</div>
			</div>
			<div class="form-group">
				<label class="col-sm-3 control-label">Loại</label>
				<div class="col-sm-9">
					<select asp-for="Input.Type" class="form-control">
						@foreach (var type in CatalogRules.CategoryTypes)
						{
							<option value="@type">@type</option>
						}
					</select>
				</div>
			</div>
			<div class="form-group">
				<label class="col-sm-3 control-label">Danh mục cha</label>
				<div class="col-sm-9">
					<select asp-for="Input.ParentId" class="form-control">
						<option value="">Không có</option>
						@foreach (var parent in Model.Parents)
						{
							<option value="@parent.Id">@parent.Label</option>
						}
					</select>
				</div>
			</div>
			<div class="clearfix form-actions">
				<div class="col-sm-offset-3 col-sm-9">
					<button type="submit" class="btn btn-primary"><i class="ace-icon fa fa-check"></i> Lưu</button>
					<a class="btn btn-default" href="/Admin/Categories">Hủy</a>
				</div>
			</div>
		</div></div>
	</div>
</form>
