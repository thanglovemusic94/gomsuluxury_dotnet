@page "/gioi-thieu"
@model WebShop.Pages.Shop.AboutModel
@{
	Layout = "_ShopLayout";
}
<div class="shop-page shop-page--about">
	<section class="shop-about-hero">
		<div class="container shop-about-hero__intro">
			@await Component.InvokeAsync("HtmlBlock", new { key = "about-hero" })
		</div>
		@if (!string.IsNullOrWhiteSpace(Model.HeroImage))
		{
			<figure class="shop-about-hero__media">
				<img src="@Model.HeroImage"
				     alt="Nghệ nhân và tinh hoa gốm Bát Tràng"
				     width="1600"
				     height="900"
				     fetchpriority="high"
				     decoding="async" />
			</figure>
		}
	</section>

	<section class="shop-about-split">
		<div class="container shop-about-split__grid">
			<div class="shop-about-split__copy">
				@await Component.InvokeAsync("HtmlBlock", new { key = "about-story" })
			</div>
			@if (!string.IsNullOrWhiteSpace(Model.StoryImage))
			{
				<figure class="shop-about-split__media">
					<img src="@Model.StoryImage"
					     alt="Không gian gốm sứ cao cấp"
					     width="900"
					     height="900"
					     loading="lazy"
					     decoding="async" />
				</figure>
			}
		</div>
	</section>

	<section class="shop-about-pillars" aria-label="Sứ mệnh và tầm nhìn">
		<div class="container">
			@await Component.InvokeAsync("HtmlBlock", new { key = "about-pillars" })
		</div>
	</section>

	<section class="shop-about-split shop-about-split--reverse">
		<div class="container shop-about-split__grid">
			@if (!string.IsNullOrWhiteSpace(Model.CraftImage))
			{
				<figure class="shop-about-split__media">
					<img src="@Model.CraftImage"
					     alt="Tác phẩm gốm thủ công Bát Tràng"
					     width="900"
					     height="900"
					     loading="lazy"
					     decoding="async" />
				</figure>
			}
			<div class="shop-about-split__copy">
				@await Component.InvokeAsync("HtmlBlock", new { key = "about-craft" })
			</div>
		</div>
	</section>

	<section class="shop-about-values" aria-label="Giá trị cốt lõi">
		<div class="container">
			@await Component.InvokeAsync("HtmlBlock", new { key = "about-values" })
		</div>
	</section>

	<section class="shop-about-stats" aria-label="Con số ấn tượng">
		@await Component.InvokeAsync("HtmlBlock", new { key = "about-stats" })
	</section>

	@if (Model.Gallery.Count > 0)
	{
		<section class="shop-about-gallery" aria-labelledby="about-gallery-heading">
			<div class="container">
				@await Component.InvokeAsync("HtmlBlock", new { key = "about-gallery-title" })
				<div class="shop-about-gallery__grid">
					@for (var i = 0; i < Model.Gallery.Count; i++)
					{
						<figure class="shop-about-gallery__item @(i == 0 ? "shop-about-gallery__item--wide" : null)">
							<img src="@Model.Gallery[i]"
							     alt=""
							     width="800"
							     height="800"
							     loading="lazy"
							     decoding="async" />
						</figure>
					}
				</div>
			</div>
		</section>
	}

	<section class="shop-about-quote">
		<div class="container shop-about-quote__inner">
			@await Component.InvokeAsync("HtmlBlock", new { key = "about-quote" })
		</div>
	</section>
</div>
