@page "/san-pham/{slug}"
@model WebShop.Pages.Shop.ProductModel
@inject WebShop.Infrastructure.HtmlBlockService Blocks
@inject WebShop.Infrastructure.ShopStore Shop
@using WebShop.Infrastructure
@{
	var item = Model.Product!;
	var price = ProductPricing.UnitPrice(item);
	var contactOnly = ProductPricing.ShowContactOnly(item);
	var snap = await Shop.GetAsync();
	var telHref = SiteContact.TelHref(snap.Hotline);
	var zaloHref = SiteContact.ZaloHref(snap.ZaloUrl, snap.Hotline);
	var facebookHref = SiteContact.FacebookHref(snap.FacebookUrl);
	var phoneLabel = SiteContact.DisplayPhone(snap.Hotline);
	if (string.IsNullOrWhiteSpace(phoneLabel))
		phoneLabel = "Hotline";
	var description = await Blocks.ExpandAsync(item.Description);
	var altBase = item.Name?.Trim() ?? "";
	if (!string.IsNullOrEmpty(altBase) &&
	    altBase.IndexOf("gốm", StringComparison.OrdinalIgnoreCase) < 0 &&
	    altBase.IndexOf("gom", StringComparison.OrdinalIgnoreCase) < 0)
	{
		altBase += " Gốm sứ";
	}

	var gallery = new List<(string Large, string Thumb, string SrcSet, string Alt)>();
	void AddGallery(string? url, string alt)
	{
		if (string.IsNullOrWhiteSpace(url)) return;
		var large = MediaUrls.For(url, MediaSize.Large);
		if (gallery.Any(g => string.Equals(g.Large, large, StringComparison.OrdinalIgnoreCase)))
			return;
		gallery.Add((large, MediaUrls.For(url, MediaSize.Thumb), MediaUrls.SrcSet(url), alt));
	}

	AddGallery(item.ImageUrl, altBase);
	foreach (var image in item.Images.OrderBy(image => image.DisplayOrder))
		AddGallery(image.ImageUrl, string.IsNullOrWhiteSpace(image.AltText) ? altBase : image.AltText!);

	var reviewCount = Model.Reviews.Count;
	var reviewAvg = reviewCount > 0 ? Math.Round(Model.Reviews.Average(r => r.Rating), 1) : 0d;
	var reviewStars = reviewCount > 0 ? (int)Math.Round(reviewAvg, MidpointRounding.AwayFromZero) : 0;
	var specRows = ProductSpecs.Parse(item.ShortDescription);
}

<div class="container shop-page shop-page--detail">
	@if (TempData["Error"] is string error)
	{
		<div class="alert alert-danger">@error</div>
	}
	@if (TempData["Message"] is string message)
	{
		<div class="alert alert-success">@message</div>
	}
	<div asp-validation-summary="All" class="alert alert-danger"></div>
	@if (TempData["CartAdded"] is not null)
	{
		<div class="shop-toast is-visible" data-shop-toast role="status" aria-live="polite">
			<span class="shop-toast__text">Đã thêm vào giỏ</span>
			<a class="shop-toast__action" href="/gio-hang">Xem giỏ hàng</a>
			<button type="button" class="shop-toast__close" data-toast-close aria-label="Đóng">×</button>
		</div>
	}

	<nav class="shop-breadcrumb shop-breadcrumb--desk" aria-label="Breadcrumb">
		<a href="/">Trang chủ</a>
		<span>/</span>
		<a href="/san-pham">Sản phẩm</a>
		<span>/</span>
		<span>@item.Name</span>
	</nav>

	<div class="shop-split">
		<div class="col-sm-6 shop-gallery" data-product-gallery>
			<div class="shop-gallery__stage">
				<a class="shop-detail-back"
				   href="/san-pham"
				   data-detail-back
				   aria-label="Quay lại">
					<i class="fa fa-angle-left" aria-hidden="true"></i>
				</a>
				@if (gallery.Count > 0)
				{
					<div class="shop-gallery__viewport" data-gallery-viewport>
						<div class="shop-gallery__track">
							@for (var i = 0; i < gallery.Count; i++)
							{
								var slide = gallery[i];
								<div class="shop-gallery__slide" data-gallery-slide="@i">
									<button type="button"
									        class="shop-gallery__zoom"
									        data-gallery-open="@i"
									        aria-label="Xem ảnh lớn @(i + 1)">
										<img class="shop-gallery__photo"
										     src="@slide.Large"
										     srcset="@slide.SrcSet"
										     sizes="(max-width: 767px) 100vw, (max-width: 991px) 50vw, min(640px, 48vw)"
										     alt="@slide.Alt"
										     width="1200"
										     height="1200"
										     fetchpriority="@(i == 0 ? "high" : "auto")"
										     loading="@(i == 0 ? "eager" : "lazy")"
										     decoding="async" />
									</button>
								</div>
							}
						</div>
					</div>
				}
				else
				{
					<div class="shop-gallery__viewport">
						<div class="shop-gallery__track">
							<div class="shop-gallery__slide">
								<div class="shop-gallery__empty" aria-hidden="true"></div>
							</div>
						</div>
					</div>
				}
				@if (gallery.Count > 1)
				{
					<div class="shop-gallery__dots" data-gallery-dots role="tablist" aria-label="Ảnh sản phẩm">
						@for (var i = 0; i < gallery.Count; i++)
						{
							<button type="button"
							        class="shop-gallery__dot @(i == 0 ? "is-active" : null)"
							        data-gallery-dot="@i"
							        aria-label="Ảnh @(i + 1)"></button>
						}
					</div>
				}
			</div>
			@if (gallery.Count > 1)
			{
				<div class="shop-thumbs @(gallery.Count > 4 ? "shop-thumbs--strip" : null)" data-gallery-thumbs>
					@for (var i = 0; i < gallery.Count; i++)
					{
						var slide = gallery[i];
						<button type="button"
						        class="shop-thumbs__btn @(i == 0 ? "is-active" : null)"
						        data-gallery-thumb="@i"
						        aria-label="Xem ảnh @(i + 1)">
							<img class="shop-photo shop-gallery__thumb"
							     src="@slide.Thumb"
							     alt=""
							     width="200"
							     height="200"
							     loading="lazy"
							     decoding="async" />
						</button>
					}
				</div>
			}

			@if (gallery.Count > 0)
			{
				<div class="shop-lightbox" data-gallery-lightbox hidden>
					<button type="button" class="shop-lightbox__close" data-lightbox-close aria-label="Đóng">×</button>
					@if (gallery.Count > 1)
					{
						<button type="button" class="shop-lightbox__nav shop-lightbox__nav--prev" data-lightbox-prev aria-label="Ảnh trước"><i class="fa fa-angle-left" aria-hidden="true"></i></button>
						<button type="button" class="shop-lightbox__nav shop-lightbox__nav--next" data-lightbox-next aria-label="Ảnh sau"><i class="fa fa-angle-right" aria-hidden="true"></i></button>
					}
					<div class="shop-lightbox__viewport" data-lightbox-viewport>
						<div class="shop-lightbox__track">
							@for (var i = 0; i < gallery.Count; i++)
							{
								var slide = gallery[i];
								<div class="shop-lightbox__slide" data-lightbox-slide="@i">
									<img src="@slide.Large"
									     srcset="@slide.SrcSet"
									     sizes="100vw"
									     alt="@slide.Alt"
									     loading="lazy"
									     decoding="async" />
								</div>
							}
						</div>
					</div>
					@if (gallery.Count > 1)
					{
						<div class="shop-lightbox__count" data-lightbox-count>1 / @gallery.Count</div>
					}
				</div>
			}
		</div>
		<div class="col-sm-6">
			<div class="shop-detail-buy">
				<h1>@item.Name</h1>
				<p class="shop-detail-buy__stock shop-detail-buy__stock--inline @(item.Stock < 1 ? "is-out" : null)">
					<span>Tình trạng: @(item.Stock > 0 ? $"Còn {item.Stock} sản phẩm" : "Hết hàng")</span>
				</p>
				@if (contactOnly)
				{
					<div class="shop-detail-buy__ask shop-detail-buy__deal--desk">
						<p class="shop-detail-buy__ask-label">Liên hệ tư vấn giá</p>
						<p class="shop-detail-buy__ask-note">Giá tùy thuộc vào kích thước / yêu cầu đóng hộp quà tặng</p>
					</div>
				}
				else
				{
					<div class="shop-detail-buy__deal shop-detail-buy__deal--desk shop-detail-buy__deal--soft">
						<p class="shop-price shop-detail-buy__price">
							<span class="shop-price__sale">@price.ToString("N0") đ</span>
							@if (item.DiscountPrice is not null)
							{
								<s class="shop-price__was">@item.Price.ToString("N0") đ</s>
							}
						</p>
					</div>
				}
				@if (reviewCount > 0)
				{
					<a class="shop-review-summary" href="#khach-hang-noi-gi">
						<span class="shop-review-summary__stars" aria-hidden="true">
							@for (var s = 1; s <= 5; s++)
							{
								<i class="fa @(s <= reviewStars ? "fa-star" : "fa-star-o")"></i>
							}
						</span>
						<span class="shop-review-summary__text">@reviewAvg.ToString("0.0") · @reviewCount nhận xét</span>
					</a>
				}
				@if (specRows.Count > 0)
				{
					<div class="shop-specs">
						<h2 class="shop-specs__title">Thông tin sản phẩm</h2>
						<dl class="shop-specs__list">
							@foreach (var row in specRows)
							{
								<div class="shop-specs__row">
									<dt>@row.Key</dt>
									<dd>@row.Value</dd>
								</div>
							}
						</dl>
					</div>
				}
				else if (!string.IsNullOrWhiteSpace(item.ShortDescription))
				{
					<div class="shop-readmore" data-readmore>
						<div class="shop-readmore__clip shop-detail-buy__short">@item.ShortDescription</div>
						<button type="button" class="shop-readmore__btn" data-readmore-toggle hidden>Xem thêm</button>
					</div>
				}
				@if (contactOnly)
				{
					<div class="shop-contact-cta" id="product-buy-form">
						@if (!string.IsNullOrWhiteSpace(telHref))
						{
							<a class="shop-contact-cta__btn shop-contact-cta__btn--phone" href="@telHref">
								<i class="fa fa-phone" aria-hidden="true"></i>
								<span>Gọi ngay: @phoneLabel</span>
							</a>
						}
						@if (!string.IsNullOrWhiteSpace(zaloHref) || !string.IsNullOrWhiteSpace(facebookHref))
						{
							<div class="shop-contact-cta__secondary">
								@if (!string.IsNullOrWhiteSpace(zaloHref))
								{
									<a class="shop-contact-cta__btn shop-contact-cta__btn--zalo" href="@zaloHref" target="_blank" rel="noopener noreferrer">
										<i class="fa fa-commenting" aria-hidden="true"></i>
										<span>Chat Zalo</span>
									</a>
								}
								@if (!string.IsNullOrWhiteSpace(facebookHref))
								{
									<a class="shop-contact-cta__btn shop-contact-cta__btn--fb" href="@facebookHref" target="_blank" rel="noopener noreferrer">
										<i class="fa fa-facebook-official" aria-hidden="true"></i>
										<span>Chat Facebook</span>
									</a>
								}
							</div>
						}
					</div>
				}
				else
				{
					<form method="post" asp-page-handler="Add" class="shop-buy-form" id="product-buy-form">
						<div class="shop-buy-form__desk">
							<label class="shop-buy-form__label" for="product-qty">Số lượng</label>
							<input id="product-qty" class="form-control shop-buy-form__qty" type="number" name="quantity" value="1" min="1" max="@Math.Max(item.Stock, 1)" inputmode="numeric" aria-label="Số lượng" />
						</div>
						<div class="shop-buy-form__bar">
							<div class="shop-buy-form__price">
								<span class="shop-buy-form__price-label">Giá bán</span>
								<span class="shop-buy-form__price-value">@price.ToString("N0") đ</span>
								@if (item.DiscountPrice is not null)
								{
									<s class="shop-buy-form__price-was">@item.Price.ToString("N0") đ</s>
								}
							</div>
							<button class="btn btn-primary shop-buy-form__submit" type="submit" @(item.Stock < 1 ? "disabled" : null)>
								<span>Thêm vào giỏ</span>
								<span class="shop-buy-form__submit-ico" aria-hidden="true"><i class="fa fa-shopping-cart"></i></span>
							</button>
						</div>
					</form>
				}
				<ul class="shop-detail-trust" aria-label="Cam kết">
					<li>Cam kết gốm Bát Tràng chính gốc 100%</li>
					<li>Kiểm tra hàng trước khi thanh toán</li>
					<li>Đổi trả 1-1 nếu vỡ hỏng do vận chuyển</li>
				</ul>
			</div>
		</div>
	</div>

	<section class="shop-detail-reviews" id="khach-hang-noi-gi" aria-labelledby="shop-reviews-heading">
		<h2 class="shop-detail-reviews__title" id="shop-reviews-heading">
			Khách hàng nói gì
			@if (reviewCount > 0)
			{
				<span class="shop-detail-reviews__meta">@reviewAvg.ToString("0.0") ★ · @reviewCount nhận xét</span>
			}
		</h2>
		@if (reviewCount == 0)
		{
			<p class="text-muted">Đang cập nhật hình ảnh và nhận xét từ khách Livestream.</p>
		}
		else
		{
			<div class="shop-reviews">
				@foreach (var review in Model.Reviews)
				{
					var badge = ProductReviewSources.BadgeLabel(review.Source);
					<figure class="shop-review">
						@if (!string.IsNullOrWhiteSpace(review.ImageUrl))
						{
							<img class="shop-review__media"
							     src="@MediaUrls.For(review.ImageUrl, MediaSize.Large)"
							     alt=""
							     loading="lazy"
							     decoding="async" />
						}
						<blockquote class="shop-review__quote">
							<p>@review.Comment</p>
							<footer>
								<span>@review.CustomerName</span>
								<span aria-label="@review.Rating trên 5 sao">@review.Rating / 5</span>
								@if (!string.IsNullOrWhiteSpace(badge))
								{
									<span class="shop-review__badge">@badge</span>
								}
							</footer>
						</blockquote>
					</figure>
				}
			</div>
		}
		<details class="shop-review-write">
			<summary>Gửi nhận xét của bạn</summary>
			<form method="post" asp-page-handler="Review" class="form-horizontal shop-review-form">
				<div class="form-group">
					<label class="col-sm-2 control-label">Tên</label>
					<div class="col-sm-6"><input asp-for="Review.CustomerName" class="form-control" autocomplete="name" /></div>
				</div>
				<div class="form-group">
					<label class="col-sm-2 control-label">Số sao</label>
					<div class="col-sm-3">
						<select asp-for="Review.Rating" class="form-control">
							<option value="5">5</option>
							<option value="4">4</option>
							<option value="3">3</option>
							<option value="2">2</option>
							<option value="1">1</option>
						</select>
					</div>
				</div>
				<div class="form-group">
					<label class="col-sm-2 control-label">Nội dung</label>
					<div class="col-sm-6"><textarea asp-for="Review.Comment" class="form-control" rows="4"></textarea></div>
				</div>
				<div class="form-group">
					<div class="col-sm-offset-2 col-sm-6">
						<button class="btn btn-primary" type="submit">Gửi</button>
					</div>
				</div>
			</form>
		</details>
	</section>

	<div class="shop-detail-panels">
		@if (!string.IsNullOrWhiteSpace(description))
		{
			<div class="shop-readmore shop-readmore--block" data-readmore>
				<h2 class="shop-readmore__heading">Mô tả sản phẩm</h2>
				<div class="shop-readmore__clip shop-detail-desc">@Html.Raw(description)</div>
				<button type="button" class="shop-readmore__btn" data-readmore-toggle hidden>Xem thêm</button>
			</div>
		}
		<details class="shop-acc">
			<summary class="shop-acc__summary">Vận chuyển &amp; đổi trả</summary>
			<div class="shop-acc__body">
				<p>Đóng gói chống sốc riêng cho đồ gốm. Giao hàng toàn quốc; thời gian dự kiến 2–5 ngày tùy khu vực.</p>
				<p>Đổi trả trong 7 ngày nếu lỗi do vận chuyển hoặc sai mẫu — sản phẩm còn nguyên tem/hộp.</p>
			</div>
		</details>
	</div>

	@if (Model.RelatedProducts.Count > 0)
	{
		<section class="shop-related" aria-labelledby="related-heading">
			<h2 id="related-heading" class="shop-title">Sản phẩm tương tự <a href="@Model.RelatedCatalogUrl">Xem tất cả</a></h2>
			<div class="shop-grid shop-grid--related-swipe">
				<partial name="_ProductCardItems" model="Model.RelatedProducts" />
			</div>
		</section>
	}
</div>
