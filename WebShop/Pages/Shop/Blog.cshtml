@page "/blog"
@model WebShop.Pages.Shop.BlogModel
@{
    ViewData["Title"] = "Blog";
}

<div class="container shop-page">
	<h1 class="shop-title">Blog</h1>
	@if (Model.Posts.Count == 0)
	{
		<div class="alert alert-warning">Chưa có bài viết.</div>
	}
	else
	{
		<div class="shop-posts">
			@foreach (var item in Model.Posts)
			{
				<article class="shop-post-card">
					@if (!string.IsNullOrWhiteSpace(item.ImageUrl))
					{
						<a href="/blog/@item.Slug" class="shop-post-card__media">
							<img src="@WebShop.Infrastructure.MediaUrls.For(item.ImageUrl, WebShop.Infrastructure.MediaSize.Thumb)"
							     alt="@item.Title"
							     width="400"
							     height="400"
							     srcset="@WebShop.Infrastructure.MediaUrls.SrcSetUpTo(item.ImageUrl, WebShop.Infrastructure.MediaSize.Thumb)"
							     sizes="(max-width: 767px) 30vw, 360px"
							     loading="lazy"
							     decoding="async" />
						</a>
					}
					<div class="shop-post-card__body">
						<h2 class="shop-post-card__title"><a href="/blog/@item.Slug">@item.Title</a></h2>
						@if (!string.IsNullOrWhiteSpace(item.Summary))
						{
							<p class="shop-post-card__summary">@item.Summary</p>
						}
					</div>
				</article>
			}
		</div>
	}
</div>
