@page "/chot/{token}"
@model WebShop.Pages.Shop.LivestreamCheckoutModel
@{
	ViewData["Title"] = "Chốt đơn Livestream";
	var cart = Model.Cart;
	var product = Model.Product;
	var isDemo = cart?.IsDemo == true;
}

<div class="container shop-page live-chot">
	@if (isDemo)
	{
		<div class="live-chot__mock-banner" role="status">
			<strong>DEMO</strong> — Link giỏ tạm thật trong DB. Bấm xác nhận sẽ tạo <em>đơn hàng thật</em> (có thể hủy/xóa trong Admin → Đơn hàng).
			<span class="live-chot__mock-banner-url">Token: <code>@(cart?.Token)</code></span>
		</div>
	}

	@if (!string.IsNullOrEmpty(Model.OrderCode))
	{
		<div class="alert alert-success">
			<h4>Đặt hàng thành công</h4>
			<p>Mã đơn của bạn là <strong>@Model.OrderCode</strong>.</p>
			@if (isDemo)
			{
				<p class="help-block">Đây là đơn demo từ livestream checkout — kiểm tra tại <a href="/Admin/Orders">Admin → Đơn hàng</a>.</p>
			}
			<a class="btn btn-primary" href="/">Về trang chủ</a>
			<a class="btn btn-default" href="/chot/demo">Tạo link demo mới</a>
		</div>
	}
	else if (!string.IsNullOrEmpty(Model.StateMessage))
	{
		<div class="alert alert-warning">
			<p>@Model.StateMessage</p>
			<a class="btn btn-default" href="/chot/demo">Tạo link demo mới</a>
			<a class="btn btn-link" href="/">Về trang chủ</a>
		</div>
	}
	else if (cart is not null && product is not null)
	{
		<section class="live-chot__messenger" aria-label="Mẫu tin Messenger">
			<div class="live-chot__messenger-label">Xem trước tin Messenger (sau này gửi qua API)</div>
			<div class="live-chot__bubble">
				<p class="live-chot__bubble-text">
					Cảm ơn bạn đã chốt đơn trên Livestream! Vui lòng bấm nút dưới đây để hoàn tất thông tin giao hàng và thanh toán cho mã sản phẩm <strong>@cart.Sku</strong>.
				</p>
				<div class="live-chot__card">
					<div class="live-chot__card-media">
						@if (!string.IsNullOrWhiteSpace(product.ImageUrl))
						{
							<img src="@product.ImageUrl" alt="@product.Name" style="width:100%;height:100%;object-fit:cover;" />
						}
						else
						{
							<i class="fa fa-cube"></i>
						}
					</div>
					<div class="live-chot__card-body">
						<div class="live-chot__card-title">@product.Name</div>
						<div class="live-chot__card-meta">@cart.Sku · @cart.UnitPrice.ToString("N0") đ</div>
						<span class="live-chot__card-btn">Hoàn tất giao hàng</span>
					</div>
				</div>
			</div>
		</section>

		<h1 class="shop-title">Chốt đơn Livestream</h1>
		<p class="live-chot__expire">
			<i class="fa fa-clock-o"></i>
			Link có hiệu lực đến <strong>@cart.ExpiresAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</strong>
			· Nguồn: @(isDemo ? "Demo" : "Facebook Live")
		</p>

		<div asp-validation-summary="All" class="alert alert-danger" style="@(ViewData.ModelState.IsValid ? "display:none" : null)"></div>

		<div class="shop-split shop-split-order live-chot__layout">
			<div class="live-chot__form-panel">
				<div class="live-chot__notice">
					Bạn đã chốt <strong>@cart.Sku</strong>. Điền địa chỉ để xác nhận đơn — bỏ qua giỏ hàng thường.
				</div>
				<form method="post" class="form-horizontal live-chot__form">
					<div class="form-group">
						<label class="col-sm-3 control-label" for="Input_CustomerName">Người nhận</label>
						<div class="col-sm-9">
							<input asp-for="Input.CustomerName" class="form-control" autocomplete="name" enterkeyhint="next" maxlength="150" />
						</div>
					</div>
					<div class="form-group">
						<label class="col-sm-3 control-label" for="Input_CustomerPhone">Số điện thoại</label>
						<div class="col-sm-9">
							<input asp-for="Input.CustomerPhone" class="form-control" type="tel" inputmode="tel" autocomplete="tel" enterkeyhint="next" maxlength="20" />
							<span class="help-block">Prefill từ comment livestream @(isDemo ? "(demo)" : "").</span>
						</div>
					</div>
					<div class="form-group">
						<label class="col-sm-3 control-label" for="Input_ShippingAddress">Địa chỉ</label>
						<div class="col-sm-9">
							<textarea asp-for="Input.ShippingAddress" class="form-control" rows="3" autocomplete="street-address" enterkeyhint="next" maxlength="500"></textarea>
						</div>
					</div>
					<div class="form-group">
						<label class="col-sm-3 control-label" for="Input_OrderNote">Ghi chú</label>
						<div class="col-sm-9">
							<textarea asp-for="Input.OrderNote" class="form-control" rows="2" autocomplete="off" enterkeyhint="done"></textarea>
						</div>
					</div>
					<div class="form-group">
						<label class="col-sm-3 control-label">Thanh toán</label>
						<div class="col-sm-9">
							<select asp-for="Input.PaymentMethod" class="form-control">
								<option value="COD">Thanh toán khi nhận hàng (COD)</option>
								<option value="Bank">Chuyển khoản</option>
							</select>
						</div>
					</div>
					<div class="form-group">
						<div class="col-sm-offset-3 col-sm-9">
							<button class="btn btn-primary live-chot__submit" type="submit">Xác nhận đơn</button>
						</div>
					</div>
				</form>
			</div>

			<aside class="live-chot__summary">
				<div class="live-chot__summary-card">
					<div class="live-chot__summary-head">Đơn tạm</div>
					<div class="live-chot__line">
						<div class="live-chot__thumb">
							@if (!string.IsNullOrWhiteSpace(product.ImageUrl))
							{
								<img src="@product.ImageUrl" alt="" style="width:100%;height:100%;object-fit:cover;" />
							}
							else
							{
								<i class="fa fa-cube"></i>
							}
						</div>
						<div class="live-chot__line-info">
							<div class="live-chot__line-name">@product.Name</div>
							<div class="live-chot__line-sku">Mã @cart.Sku · Số lượng × @cart.Quantity</div>
							<div class="shop-price">@cart.UnitPrice.ToString("N0") đ</div>
						</div>
					</div>
					<hr class="live-chot__hr" />
					<div class="live-chot__total">
						<span>Tổng</span>
						<strong class="shop-price">@((cart.UnitPrice * cart.Quantity).ToString("N0")) đ</strong>
					</div>
					<p class="live-chot__summary-note">Không đổi sản phẩm / số lượng trên link này.</p>
				</div>
			</aside>
		</div>
	}
</div>
