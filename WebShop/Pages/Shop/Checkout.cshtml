@page "/thanh-toan"
@model WebShop.Pages.Shop.CheckoutModel
@{
    ViewData["Title"] = "Đặt hàng";
}

<div class="container shop-page">
	<h1 class="shop-title">Đặt hàng</h1>
	@if (!string.IsNullOrEmpty(Model.OrderCode))
	{
		<div class="alert alert-success">
			<h4>Đặt hàng thành công</h4>
			<p>Mã đơn của bạn là <strong>@Model.OrderCode</strong>.</p>
			<a class="btn btn-primary" href="/">Về trang chủ</a>
		</div>
	}
	else
	{
		<div asp-validation-summary="All" class="alert alert-danger"></div>
		<div class="shop-split shop-split-order">
			<div class="col-sm-7">
				<form method="post" class="form-horizontal">
					<div class="form-group">
						<label class="col-sm-3 control-label" for="Input_CustomerName">Người nhận</label>
						<div class="col-sm-8">
							<input asp-for="Input.CustomerName" class="form-control" autocomplete="name" enterkeyhint="next" maxlength="150" />
						</div>
					</div>
					<div class="form-group">
						<label class="col-sm-3 control-label" for="Input_CustomerPhone">Số điện thoại</label>
						<div class="col-sm-8">
							<input asp-for="Input.CustomerPhone" class="form-control" type="tel" inputmode="tel" autocomplete="tel" enterkeyhint="next" maxlength="20" />
						</div>
					</div>
					<div class="form-group">
						<label class="col-sm-3 control-label" for="Input_ShippingAddress">Địa chỉ</label>
						<div class="col-sm-8">
							<textarea asp-for="Input.ShippingAddress" class="form-control" rows="3" autocomplete="street-address" enterkeyhint="next" maxlength="500"></textarea>
						</div>
					</div>
					<div class="form-group">
						<label class="col-sm-3 control-label" for="Input_OrderNote">Ghi chú</label>
						<div class="col-sm-8">
							<textarea asp-for="Input.OrderNote" class="form-control" rows="2" autocomplete="off" enterkeyhint="done"></textarea>
						</div>
					</div>
					<div class="form-group">
						<label class="col-sm-3 control-label">Thanh toán</label>
						<div class="col-sm-8">
							<select asp-for="Input.PaymentMethod" class="form-control">
								<option value="COD">Thanh toán khi nhận hàng</option>
								<option value="Bank">Chuyển khoản</option>
							</select>
						</div>
					</div>
					<div class="form-group">
						<div class="col-sm-offset-3 col-sm-8">
							<button class="btn btn-primary" type="submit">Xác nhận đơn</button>
						</div>
					</div>
				</form>
			</div>
			<div class="col-sm-5">
				<div>
					@foreach (var line in Model.Lines)
					{
						<p>@line.Name × @line.Quantity <span class="shop-price pull-right">@((line.UnitPrice * line.Quantity).ToString("N0")) đ</span></p>
					}
					<hr />
					<p><strong>Tổng @Model.Lines.Sum(line => line.UnitPrice * line.Quantity).ToString("N0") đ</strong></p>
				</div>
			</div>
		</div>
	}
</div>
