@page
@using WebShop.Infrastructure
@{
	ViewData["Title"] = "Không có quyền";
	Layout = "_ShopLayout";
}

<section class="shop-section">
	<div class="shop-wrap" style="padding:48px 16px;text-align:center;">
		<h1>Không có quyền truy cập</h1>
		<p class="text-muted">Tài khoản của bạn không được phép mở trang này.</p>
		<p>
			<a class="btn btn-primary" href="/">Về trang chủ</a>
			@if (AppRoles.IsStaffArea(User))
			{
				<a class="btn btn-default" href="/Admin">Về trang quản trị</a>
			}
		</p>
	</div>
</section>
