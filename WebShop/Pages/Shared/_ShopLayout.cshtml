@inject IHttpContextAccessor HttpContextAccessor
@inject ShopStore Shop
@{
	var assets = (ViewData["ShopAssets"] as string ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
	bool Has(string key) => assets.Contains(key, StringComparer.OrdinalIgnoreCase);
	var lcp = ViewData["LcpImage"] as string;
	var lcpSrcSet = ViewData["LcpImageSrcSet"] as string;
	var lcpSizes = ViewData["LcpImageSizes"] as string ?? "100vw";
	var isHome = Has("home");
	var request = HttpContextAccessor.HttpContext?.Request;
	var allowIndex = HttpContextAccessor.HttpContext?.Items[SiteSeoService.AllowIndexingKey] as bool? ?? false;
	var snap = await Shop.GetAsync();
	var pageTitle = ViewData["Title"] as string ?? snap.SiteName;
	var description = ViewData["Description"] as string;
	if (string.IsNullOrWhiteSpace(description))
		description = snap.SiteName;
	var ogType = ViewData["OgType"] as string ?? "website";
	var ogImageRaw = SiteSocial.PickImage(
		ViewData["OgImage"] as string,
		snap.ShareImageUrl);
	var ogImage = request is null ? ogImageRaw : SiteSocial.Absolute(request, MediaUrls.For(ogImageRaw, MediaSize.Large));
	if (string.IsNullOrWhiteSpace(ogImage) && request is not null)
		ogImage = SiteSocial.Absolute(request, MediaUrls.For(ogImageRaw, MediaSize.Medium));
	var canonical = request is null
		? string.Empty
		: SiteSocial.Absolute(request, $"{request.PathBase}{request.Path}{request.QueryString}");
}
<!DOCTYPE html>
<html lang="vi">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<title>@pageTitle</title>
	<link rel="icon" href="/favicon.ico?v=2" sizes="any" />
	<link rel="icon" href="/favicon-32.png?v=2" type="image/png" sizes="32x32" />
	<link rel="icon" href="/favicon-48.png?v=2" type="image/png" sizes="48x48" />
	<link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2" />
	@if (!allowIndex)
	{
		<meta name="robots" content="noindex,nofollow" />
	}
	@if (!string.IsNullOrWhiteSpace(description))
	{
		<meta name="description" content="@description" />
	}
	@if (!string.IsNullOrWhiteSpace(canonical))
	{
		<link rel="canonical" href="@canonical" />
		<meta property="og:url" content="@canonical" />
	}
	<meta property="og:site_name" content="@snap.SiteName" />
	<meta property="og:type" content="@ogType" />
	<meta property="og:title" content="@pageTitle" />
	<meta property="og:description" content="@description" />
	@if (!string.IsNullOrWhiteSpace(ogImage))
	{
		<meta property="og:image" content="@ogImage" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:image" content="@ogImage" />
	}
	else
	{
		<meta name="twitter:card" content="summary" />
	}
	<meta name="twitter:title" content="@pageTitle" />
	<meta name="twitter:description" content="@description" />
	@{
		var jsonLd = new List<string>();
		if (request is not null)
		{
			jsonLd.Add(SchemaOrg.Serialize(SchemaOrg.Organization(snap, request)));
			if (isHome)
				jsonLd.Add(SchemaOrg.Serialize(SchemaOrg.WebSite(snap, request)));
			if (ViewData["JsonLd"] is string one && !string.IsNullOrWhiteSpace(one))
				jsonLd.Add(one);
			else if (ViewData["JsonLd"] is IEnumerable<string> many)
			{
				foreach (var item in many)
				{
					if (!string.IsNullOrWhiteSpace(item))
						jsonLd.Add(item);
				}
			}
		}
	}
	@foreach (var block in jsonLd)
	{
		<script type="application/ld+json">@Html.Raw(block)</script>
	}
	<link rel="preconnect" href="https://fonts.googleapis.com" />
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
	@* Body font: keep in critical path (small). Display font + FA: non-blocking. *@
	<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;600&amp;display=swap" />
	<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@600;700&amp;display=swap" media="print" onload="this.media='all'" />
	<link rel="stylesheet" href="/ace/assets/font-awesome/4.5.0/css/font-awesome.min.css" media="print" onload="this.media='all'" />
	<noscript>
		<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@600;700&amp;display=swap" />
		<link rel="stylesheet" href="/ace/assets/font-awesome/4.5.0/css/font-awesome.min.css" />
	</noscript>
	@if (isHome)
	{
		<link rel="preload" href="~/css/shop.css" as="style" asp-append-version="true" />
	}
	<link rel="stylesheet" href="~/css/shop.css" asp-append-version="true" />
	@if (!string.IsNullOrWhiteSpace(lcp))
	{
		if (!string.IsNullOrWhiteSpace(lcpSrcSet))
		{
			<link rel="preload" as="image" href="@lcp" imagesrcset="@lcpSrcSet" imagesizes="@lcpSizes" fetchpriority="high" />
		}
		else
		{
			<link rel="preload" as="image" href="@lcp" fetchpriority="high" />
		}
	}
	@await RenderSectionAsync("Styles", required: false)
</head>
<body class="shop@(ViewData["ImmersiveDetail"] is true ? " shop--detail-immersive" : null)">
	@await Component.InvokeAsync("ShopHeader")
	<main id="main" class="shop-main">
		@RenderBody()
	</main>
	@await Component.InvokeAsync("ShopFooter")
	<script src="~/js/shop-core.js" asp-append-version="true" defer></script>
	@if (Has("home"))
	{
		<script src="~/js/shop-home.js" asp-append-version="true" defer></script>
	}
	@if (Has("detail"))
	{
		<script src="~/js/shop-detail.js" asp-append-version="true" defer></script>
	}
	@if (Has("catalog"))
	{
		<script src="~/js/shop-catalog.js" asp-append-version="true" defer></script>
	}
	@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
