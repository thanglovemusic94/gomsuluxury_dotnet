@model IEnumerable<WebShop.Models.Product>
@using WebShop.Infrastructure
@foreach (var item in Model)
{
	var price = ProductPricing.UnitPrice(item);
	var contactOnly = ProductPricing.ShowContactOnly(item);
	var alt = item.Name?.Trim() ?? "";
	if (!string.IsNullOrEmpty(alt) &&
	    alt.IndexOf("gốm", StringComparison.OrdinalIgnoreCase) < 0 &&
	    alt.IndexOf("gom", StringComparison.OrdinalIgnoreCase) < 0)
	{
		alt += " Gốm sứ";
	}
	<article class="shop-card @(contactOnly ? "shop-card--name" : null)">
		<a href="/san-pham/@item.Slug">
			<span class="shop-card__media shop-media-skel">
				<shop-img src="@item.ImageUrl"
				          profile="card"
				          alt="@alt"
				          width="800"
				          height="800"
				          loading="lazy" />
				@if (!string.IsNullOrWhiteSpace(item.CardHoverImageUrl))
				{
					<shop-img src="@item.CardHoverImageUrl"
					          class="shop-card__alt"
					          profile="card"
					          alt="@alt"
					          width="800"
					          height="800"
					          loading="lazy" />
				}
			</span>
			<h3 class="shop-card__title">@item.Name</h3>
		</a>
		@if (!contactOnly)
		{
			<div class="shop-price">
				<span class="shop-price__sale">@price.ToString("N0") đ</span>
				@if (item.DiscountPrice is not null)
				{
					<s class="shop-price__was">@item.Price.ToString("N0") đ</s>
				}
			</div>
		}
	</article>
}
