@inject IHttpContextAccessor HttpContextAccessor
@inject ShopStore Shop
@{
	var request = HttpContextAccessor.HttpContext?.Request;
	var snap = await Shop.GetAsync();
	var pageTitle = ViewData["Title"] as string ?? snap.SiteName;
	var description = ViewData["Description"] as string;
	if (string.IsNullOrWhiteSpace(description))
		description = snap.SiteName;
	var ogType = ViewData["OgType"] as string ?? "website";
	var ogImageRaw = SiteSocial.PickImage(
		ViewData["OgImage"] as string,
		snap.ShareImageUrl);
	var ogImage = request is null ? ogImageRaw : SiteSocial.Absolute(request, MediaUrls.For(ogImageRaw, MediaSize.Large));
	if (string.IsNullOrWhiteSpace(ogImage) && request is not null)
		ogImage = SiteSocial.Absolute(request, MediaUrls.For(ogImageRaw, MediaSize.Medium));
	var canonical = request is null
		? string.Empty
		: SiteSocial.Absolute(request, $"{request.PathBase}{request.Path}{request.QueryString}");
	var ogW = ViewData["OgImageWidth"] as int? ?? SiteSocial.OgImageWidth;
	var ogH = ViewData["OgImageHeight"] as int? ?? SiteSocial.OgImageHeight;
}
@if (!string.IsNullOrWhiteSpace(canonical))
{
	<link rel="canonical" href="@canonical" />
	<meta property="og:url" content="@canonical" />
}
<meta property="og:locale" content="vi_VN" />
<meta property="og:site_name" content="@snap.SiteName" />
<meta property="og:type" content="@ogType" />
<meta property="og:title" content="@pageTitle" />
<meta property="og:description" content="@description" />
@if (!string.IsNullOrWhiteSpace(ogImage))
{
	<meta property="og:image" content="@ogImage" />
	@if (ogImage.StartsWith("https://", StringComparison.OrdinalIgnoreCase))
	{
		<meta property="og:image:secure_url" content="@ogImage" />
	}
	<meta property="og:image:width" content="@ogW" />
	<meta property="og:image:height" content="@ogH" />
	<meta property="og:image:alt" content="@pageTitle" />
	<meta name="twitter:card" content="summary_large_image" />
	<meta name="twitter:image" content="@ogImage" />
}
else
{
	<meta name="twitter:card" content="summary" />
}
<meta name="twitter:title" content="@pageTitle" />
<meta name="twitter:description" content="@description" />
